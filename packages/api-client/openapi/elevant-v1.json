{
  "openapi": "3.0.4",
  "info": {
    "title": "Elevant API",
    "description": "Versioned HTTP API for the Elevant platform.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/auth/session": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Exchanges valid Development credentials for a short-lived bearer token.",
        "operationId": "CreateSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Returns the current actor after revalidating its effective scope in SQL.",
        "operationId": "GetCurrentSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/system/ping": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Confirms that the HTTP process is responding.",
        "operationId": "GetSystemPing",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemPingResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "additionalProperties": false
      },
      "CurrentSessionResponse": {
        "required": [
          "actor"
        ],
        "type": "object",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/SessionActorResponse"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "SessionActorResponse": {
        "required": [
          "accountId",
          "displayName",
          "email",
          "memberships",
          "roles",
          "stationScopes"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionRoleResponse"
            }
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionMembershipResponse"
            }
          },
          "stationScopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionStationScopeResponse"
            }
          }
        },
        "additionalProperties": false
      },
      "SessionMembershipKind": {
        "enum": [
          "internal_staff",
          "airline_client"
        ],
        "type": "string"
      },
      "SessionMembershipResponse": {
        "required": [
          "kind",
          "membershipId",
          "organizationCode",
          "organizationId",
          "organizationName",
          "organizationType"
        ],
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationCode": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "organizationType": {
            "$ref": "#/components/schemas/SessionOrganizationType"
          },
          "kind": {
            "$ref": "#/components/schemas/SessionMembershipKind"
          }
        },
        "additionalProperties": false
      },
      "SessionOrganizationType": {
        "enum": [
          "aviam_operator",
          "airline_customer"
        ],
        "type": "string"
      },
      "SessionPortal": {
        "enum": [
          "back_office",
          "ramp_mobile_app",
          "airline_portal"
        ],
        "type": "string"
      },
      "SessionResponse": {
        "required": [
          "accessToken",
          "actor",
          "expiresAt",
          "tokenType"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "$ref": "#/components/schemas/SessionActorResponse"
          }
        },
        "additionalProperties": false
      },
      "SessionRoleResponse": {
        "required": [
          "code",
          "name",
          "portal",
          "roleId",
          "userType"
        ],
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "portal": {
            "$ref": "#/components/schemas/SessionPortal"
          },
          "userType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SessionStationScopeResponse": {
        "required": [
          "stationCode",
          "stationId"
        ],
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string",
            "format": "uuid"
          },
          "stationCode": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SystemPingResponse": {
        "required": [
          "application",
          "environment",
          "status",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Short-lived ELEVANT access token issued by POST /api/v1/auth/session.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "System"
    }
  ]
}