# Copy values into your local environment or deployment secret store; this file is not loaded automatically.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
AllowedHosts=elevant-dev-api.REPLACE_TAILNET.ts.net;localhost;127.0.0.1
ELEVANT_DATABASE_ENVIRONMENT=Development
ConnectionStrings__ElevantDatabase=Server=elevant-dev-sql,1433;Initial Catalog=ElevantDevelopmentDb;User ID=elevant_dev_app;Password=REPLACE_ME_AppPassword!2026;Encrypt=True;TrustServerCertificate=True
Cors__AllowedOrigins__0=https://elevant-dev-aviam-web.REPLACE_TAILNET.ts.net
Cors__AllowedOrigins__1=https://elevant-dev-public-web.REPLACE_TAILNET.ts.net
Cors__AllowedOrigins__2=http://localhost:5173
Cors__AllowedOrigins__3=http://localhost:3000
FlightAware__BaseUrl=https://aeroapi.flightaware.com/aeroapi/
FlightAware__ApiKey=
Authentication__Issuer=Elevant.Development
Authentication__Audience=Elevant.Clients.Development
# Generate at least 32 random bytes and inject the value from the deployment secret store. Never commit the real key.
Authentication__SigningKeyBase64=REPLACE_ME
Authentication__AccessTokenMinutes=15
# Portal emails (ADR-0022): SMTP of the no-reply account. Empty Smtp__Host keeps emails pending.
# Gmail: smtp.gmail.com, port 587, TLS, the full address as user and an app password (16 letters).
Smtp__Host=
Smtp__Port=587
Smtp__UseTls=true
Smtp__Username=
# Inject from the deployment secret store. Never commit the real password.
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=ELEVANT
# Origin of the public portal used in activation and password-reset links.
AccountEmail__PublicWebBaseUrl=https://elevant-dev-public-web.REPLACE_TAILNET.ts.net
AccountEmail__RequireAirlineLoginCode=true
ForwardedHeaders__Enabled=false
# When enabled, configure at least one trusted proxy/network, for example:
# ForwardedHeaders__KnownProxies__0=REPLACE_WITH_RUNTIME_GATEWAY_IP
HttpsRedirection__Enabled=false
