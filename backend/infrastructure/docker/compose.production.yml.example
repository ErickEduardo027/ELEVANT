name: elevant-production

services:
  api:
    build:
      context: ../..
      dockerfile: Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: "Production"
      ASPNETCORE_HTTP_PORTS: "8080"
      ConnectionStrings__ElevantDatabase: "${ELEVANT_DATABASE_CONNECTION_STRING:?ELEVANT_DATABASE_CONNECTION_STRING must be set with a least-privilege application login}"
      Cors__AllowedOrigins__0: "${CORS_ALLOWED_ORIGIN:?CORS_ALLOWED_ORIGIN must be set}"
      HttpsRedirection__Enabled: "false"
      Swagger__Enabled: "false"
    expose:
      - "8080"
    depends_on:
      sqlserver:
        condition: service_healthy
    restart: always
    stop_grace_period: 30s
    networks:
      - edge
      - data

  sqlserver:
    image: "${MSSQL_IMAGE:-mcr.microsoft.com/mssql/server:2022-latest}"
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "${MSSQL_PID:-Express}"
      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD:?MSSQL_SA_PASSWORD must be set}"
    volumes:
      - sql-production-data:/var/opt/mssql
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          if [ -x /opt/mssql-tools18/bin/sqlcmd ]; then
            /opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P "$${MSSQL_SA_PASSWORD}" -C -Q "SELECT 1" -b -o /dev/null;
          else
            /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P "$${MSSQL_SA_PASSWORD}" -C -Q "SELECT 1" -b -o /dev/null;
          fi
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 45s
    restart: always
    stop_grace_period: 60s
    networks:
      - data

volumes:
  sql-production-data:
    name: elevant-sql-production-data

networks:
  edge:
    name: elevant-production-edge
  data:
    name: elevant-production-data
    internal: true
