FROM scratch

ARG VCS_REF
ARG OCI_SOURCE
ARG OCI_CREATED
ARG OPENAPI_SHA256

LABEL org.opencontainers.image.title="ELEVANT Development API release bundle" \
      org.opencontainers.image.description="Certified immutable inputs for ELEVANT Development API promotion" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.elevant.api.environment="Development" \
      org.elevant.api.manifest.schema="1" \
      io.elevant.api-release.bundle-version="1" \
      io.elevant.api-release.media-type="application/vnd.elevant.api-release-bundle.v1" \
      io.elevant.api-release.openapi-sha256="${OPENAPI_SHA256}"

COPY manifest.json /manifest.json
COPY compose/compose.development.api.yml /compose/compose.development.api.yml

CMD ["/manifest.json"]
