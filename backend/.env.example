# Docker local
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_SA_PASSWORD=REPLACE_ME_StrongLocalPassword123!
ELEVANT_DB_NAME=ElevantDevelopmentDb
ELEVANT_DATABASE_CONNECTION_STRING=Server=sqlserver,1433;Database=REPLACE_WITH_ENVIRONMENT_DATABASE;User Id=elevant_app;Password=REPLACE_ME_ApplicationPassword123!;Encrypt=True;TrustServerCertificate=True
MSSQL_PORT=1433
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ASP.NET Core (para ejecución fuera de Docker, ajuste Server según corresponda)
ConnectionStrings__ElevantDatabase=Server=127.0.0.1,1433;Database=ElevantDevelopmentDb;User Id=sa;Password=REPLACE_ME_StrongLocalPassword123!;Encrypt=True;TrustServerCertificate=True
Cors__AllowedOrigins__0=http://localhost:3000
FlightAware__BaseUrl=https://aeroapi.flightaware.com/aeroapi/
FlightAware__ApiKey=
Authentication__Issuer=REPLACE_WITH_ISSUER
Authentication__Audience=REPLACE_WITH_AUDIENCE
Authentication__SigningKey=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
