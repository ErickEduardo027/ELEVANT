# Valores públicos incluidos en la aplicación. No agregar secretos ni tokens.
EXPO_PUBLIC_ELEVANT_API_URL=https://<PRIVATE_API_SERVICE>.<TAILNET_DNS_NAME>.ts.net

# Solo para desarrollo local. __DEV__ debe ser true; los builds de producción
# ignoran este modo aunque la variable exista.
EXPO_PUBLIC_ENABLE_LOCAL_AUTH=false

# Sustituye los placeholders por los valores del ambiente antes de ejecutar la app.
