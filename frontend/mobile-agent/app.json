{
  "expo": {
    "name": "ELEVANT Mobile Agent",
    "slug": "elevant-mobile-agent",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/elevant-symbol.png",
    "scheme": "elevant",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elevant.mobileagent",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/elevant-symbol.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elevant.mobileagent",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/elevant-symbol.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/elevant-logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "357972be-0e79-4e27-8af0-dd4a6ae5b9e6"
      }
    },
    "owner": "eliezer02"
  }
}
