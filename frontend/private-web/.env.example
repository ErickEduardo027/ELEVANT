# Variables públicas de Next.js. Nunca incluir secretos.
# El build de Development exige el mismo origen HTTPS en ambas variables.
NEXT_PUBLIC_ELEVANT_API_URL=https://api.elevant.test
NEXT_PUBLIC_PROTOTYPE_API_URL=https://api.elevant.test
NEXT_PUBLIC_HR_DEMO_MODE=dashboard-read-only
NEXT_PUBLIC_FLIGHT_MAP_STYLE_LIGHT=
NEXT_PUBLIC_FLIGHT_MAP_STYLE_DARK=
NEXT_PUBLIC_POSITIONS_MAP_STYLE_LIGHT=
NEXT_PUBLIC_POSITIONS_MAP_STYLE_DARK=
