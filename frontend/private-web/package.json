{
  "name": "elevant-private-web",
  "private": true,
  "version": "0.0.0",
  "description": "Internal AVIAM operations application built with Next.js.",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "node ./scripts/run-next.mjs dev --webpack",
    "start": "node ./scripts/run-next.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:development-env": "node ./scripts/validate-development-env.mjs",
    "test:delivery": "node --test ./scripts/test-development-delivery.mjs",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "npm run validate:development-env && node ./scripts/run-next.mjs build && node ./scripts/verify-maplibre-worker.mjs",
    "preview": "node ./scripts/run-next.mjs start",
    "test": "vitest run --configLoader runner --config vitest.config.mjs"
  },
  "dependencies": {
    "@elevant/api-client": "file:../../packages/api-client",
    "@microsoft/signalr": "^10.0.11",
    "maplibre-gl": "6.16.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
