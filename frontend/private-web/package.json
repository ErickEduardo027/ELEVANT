{
  "name": "elevant-web-preview",
  "private": true,
  "version": "0.0.0",
  "description": "Internal AVIAM operations application built with Vite and React.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:development-env": "node ./scripts/validate-development-env.mjs",
    "test:delivery": "node --test ./scripts/test-development-delivery.mjs",
    "build": "npm run validate:development-env && vite build --configLoader runner && node ./scripts/verify-maplibre-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@elevant/api-client": "file:../../packages/api-client",
    "@googlemaps/js-api-loader": "^2.1.3",
    "maplibre-gl": "^6.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
