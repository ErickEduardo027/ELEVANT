# Rename to web-ci.yml after resolving the current Public Web lint debt in
# src/components/portal/PortalRequests.tsx. Both applications use npm locks.
name: Web clients CI

on:
  push:
    branches: [main, Development]
    paths:
      - "frontend/private-web/**"
      - "frontend/public-web/**"
      - "packages/api-client/**"
      - ".github/workflows/web-ci.yml"
  pull_request:
    branches: [main, Development]
    paths:
      - "frontend/private-web/**"
      - "frontend/public-web/**"
      - "packages/api-client/**"
      - ".github/workflows/web-ci.yml"

permissions:
  contents: read

jobs:
  aviam-web:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend/private-web
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: frontend/private-web/package-lock.json
      - run: npm ci
      - run: npm test
      - run: npm run build

  public-web:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend/public-web
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: frontend/public-web/package-lock.json
      - run: npm ci
      - run: npm run lint
      - run: npm run typecheck
      - run: npm test
      - run: npm run build
