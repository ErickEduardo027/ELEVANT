# Rename to mobile-ci.yml when the team enables Mobile CI. APK/EAS signing is a
# separate release workflow with protected credentials; this job only validates source.
name: Mobile Agent CI

on:
  push:
    branches: [main, Development]
    paths:
      - "frontend/mobile-agent/**"
      - "packages/api-client/**"
      - ".github/workflows/mobile-ci.yml"
  pull_request:
    branches: [main, Development]
    paths:
      - "frontend/mobile-agent/**"
      - "packages/api-client/**"
      - ".github/workflows/mobile-ci.yml"

permissions:
  contents: read

jobs:
  mobile:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: frontend/mobile-agent
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm
          cache-dependency-path: frontend/mobile-agent/package-lock.json
      - run: npm ci
      - run: npm run lint
