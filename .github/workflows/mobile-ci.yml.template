# Renombrar a mobile-ci.yml solamente cuando frontend/mobile-agent tenga Expo, scripts y lockfile reales.
name: Mobile CI

on:
  push:
    branches: [main, develop]
    paths:
      - "frontend/mobile-agent/**"
      - "packages/api-client/**"
      - "package.json"
      - "pnpm-workspace.yaml"
      - "pnpm-lock.yaml"
  pull_request:
    branches: [main, develop]
    paths:
      - "frontend/mobile-agent/**"
      - "packages/api-client/**"
      - "package.json"
      - "pnpm-workspace.yaml"
      - "pnpm-lock.yaml"

permissions:
  contents: read

jobs:
  mobile:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: pnpm
      - run: corepack enable
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter @elevant/mobile-agent lint
      - run: pnpm --filter @elevant/mobile-agent typecheck
