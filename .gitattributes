* text=auto eol=lf

*.sln text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.apk binary
*.aab binary
