ARG MSSQL_BASE_IMAGE=mcr.microsoft.com/mssql/server:2022-CU26-ubuntu-22.04@sha256:ba4c8329f48fb8f02e1416be6a930ebfd71268caee78aa985f3af4315e457c89
ARG VCS_REF=unknown
ARG OCI_SOURCE=https://github.com/ErickEduardo027/ELEVANT
FROM ${MSSQL_BASE_IMAGE}

ARG VCS_REF
ARG OCI_SOURCE
LABEL org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.source=${OCI_SOURCE}
USER root
WORKDIR /opt/elevant-db-ops
RUN install -d -m 0555 /opt/elevant-db-ops/sql
COPY --chmod=0444 database/DevelopmentDB/scripts/bootstrap/provision-development.sql ./sql/provision-development.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/bootstrap/provision-development-team-access.sql ./sql/provision-development-team-access.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/bootstrap/install-development-diagram-support.sql ./sql/install-development-diagram-support.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/backup/backup-development.sql ./sql/backup-development.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/recovery/restore-check-development.sql ./sql/restore-check-development.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/diagnostics/verify-development.sql ./sql/verify-development.sql
COPY --chmod=0444 database/DevelopmentDB/scripts/diagnostics/verify-development-team-access.sql ./sql/verify-development-team-access.sql
COPY --chmod=0555 database/DevelopmentDB/scripts/container/entrypoint.sh ./entrypoint.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/initialize-backup-storage.sh ./initialize-backup-storage.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/provision-development.sh ./provision-development.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/provision-development-team-access.sh ./provision-development-team-access.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/install-development-diagram-support.sh ./install-development-diagram-support.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/backup-development.sh ./backup-development.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/restore-check-development.sh ./restore-check-development.sh
COPY --chmod=0555 database/DevelopmentDB/scripts/container/verify-development.sh ./verify-development.sh
USER mssql

ENTRYPOINT ["/opt/elevant-db-ops/entrypoint.sh"]
