# Development local only. Replace every REPLACE_ME value before use.
# Database passwords accepted by the bootstrap are 16-128 characters from:
# A-Z a-z 0-9 ! @ # % _ + = : . , ? -
MSSQL_SA_PASSWORD=REPLACE_ME_SaPassword!2026
ELEVANT_DB_DBA_PASSWORD=REPLACE_ME_DbaPassword!2026
ELEVANT_DB_MIGRATOR_PASSWORD=REPLACE_ME_Migrator!2026
ELEVANT_DB_APP_PASSWORD=REPLACE_ME_AppPassword!2026
ELEVANT_DB_SEEDER_PASSWORD=REPLACE_ME_SeederPassword!2026
ELEVANT_DB_HEALTH_PASSWORD=REPLACE_ME_HealthPassword!2026
ELEVANT_DB_BACKUP_PASSWORD=REPLACE_ME_BackupPassword!2026
ELEVANT_DEV_ADMIN_ACCOUNT_PASSWORD=REPLACE_ME_AdminAccount!2026
ELEVANT_DEV_RAMP_ACCOUNT_PASSWORD=REPLACE_ME_RampAccount!2026
ELEVANT_DEV_AIRLINE_ACCOUNT_PASSWORD=REPLACE_ME_AirlineAccount!2026
ELEVANT_DEV_HUMAN_RESOURCES_ACCOUNT_PASSWORD=REPLACE_ME_HumanResourcesAccount!2026
ELEVANT_DEV_CONTRACTS_ACCOUNT_PASSWORD=REPLACE_ME_ContractsAccount!2026
ELEVANT_DEV_FINANCE_ACCOUNT_PASSWORD=REPLACE_ME_FinanceAccount!2026
ELEVANT_DEV_SUPERADMIN_ACCOUNT_PASSWORD=REPLACE_ME_SuperAdminAccount!2026
MSSQL_PORT=1433
API_PORT=8080
CORS_ALLOWED_ORIGIN_0=http://localhost:5173
CORS_ALLOWED_ORIGIN_1=http://localhost:3000

# Direct ASP.NET/EF tooling outside Docker. Do not put a real shared password here.
ELEVANT_DATABASE_ENVIRONMENT=Development
ConnectionStrings__ElevantDatabase=Server=127.0.0.1,1433;Initial Catalog=ElevantDevelopmentDb;User ID=elevant_dev_app;Password=REPLACE_ME_AppPassword!2026;Encrypt=True;TrustServerCertificate=True
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
FlightAware__BaseUrl=https://aeroapi.flightaware.com/aeroapi/
FlightAware__ApiKey=
Authentication__Issuer=REPLACE_WITH_ISSUER
Authentication__Audience=REPLACE_WITH_AUDIENCE
Authentication__SigningKeyBase64=REPLACE_ME
Authentication__AccessTokenMinutes=15
# Portal emails (ADR-0022). Empty Smtp__Host uses the local Mailpit (http://127.0.0.1:8025).
# For real delivery set the no-reply account here, e.g. Gmail: smtp.gmail.com, 587, TLS and an app password.
Smtp__Host=
Smtp__Port=587
Smtp__UseTls=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=ELEVANT

# Paid flight feed AeroDataBox (ADR-0028). Leave disabled locally: every call spends plan units.
ELEVANT_AERODATABOX_ENABLED=false
ELEVANT_AERODATABOX_API_KEY=
ELEVANT_AERODATABOX_DAILY_UNITS=1200
ELEVANT_AERODATABOX_MONTHLY_UNITS=38000
AccountEmail__PublicWebBaseUrl=http://localhost:3000

# Dokploy Development uses immutable GHCR references including @sha256:<digest>.
ELEVANT_DB_OPS_IMAGE=ghcr.io/REPLACE_NAMESPACE/elevant-db-ops@sha256:REPLACE_DIGEST
ELEVANT_DB_RELEASE_IMAGE=ghcr.io/REPLACE_NAMESPACE/elevant-db-release@sha256:REPLACE_DIGEST
ELEVANT_MIGRATOR_CONNECTION_STRING=Server=elevant-dev-sql,1433;Initial Catalog=ElevantDevelopmentDb;User ID=elevant_dev_migrator;Password=REPLACE_ME_Migrator!2026;Encrypt=True;TrustServerCertificate=True
ELEVANT_SEEDER_CONNECTION_STRING=Server=elevant-dev-sql,1433;Initial Catalog=ElevantDevelopmentDb;User ID=elevant_dev_seeder;Password=REPLACE_ME_SeederPassword!2026;Encrypt=True;TrustServerCertificate=True
