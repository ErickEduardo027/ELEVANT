# Replace every REPLACE_* value in the restricted installed copy only.
# Keep this repository example secret-free.
ELEVANT_API_CD_MANIFEST_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-api-release-manifest
ELEVANT_API_CD_MANIFEST_ALIAS=development-certified
ELEVANT_API_CD_EXPECTED_REPOSITORY=REPLACE_OWNER/REPLACE_REPOSITORY
ELEVANT_API_CD_EXPECTED_REF=refs/heads/Development
ELEVANT_API_CD_API_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-api

# Database provenance is read from the already-installed database controller.
ELEVANT_API_CD_DATABASE_MANIFEST_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-release-manifest
ELEVANT_API_CD_DATABASE_OPS_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-ops
ELEVANT_API_CD_DATABASE_RELEASE_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-release
ELEVANT_API_CD_DATABASE_STATE=/etc/dokploy/elevant/database-cd/state/last-success.json
ELEVANT_API_CD_DATABASE_LOCK=/etc/dokploy/elevant/database-cd/state/controller.lock
ELEVANT_API_CD_DATABASE_MANIFEST_TOOL=/etc/dokploy/elevant/database-cd/manifest-tool.mjs

# Paths are inside the private Dokploy container. The live Compose and .env are
# created manually from reviewed inputs before this controller is enabled.
ELEVANT_API_CD_DOCKER_CONFIG=/root/.docker
ELEVANT_API_CD_PROJECT=REPLACE_API_COMPOSE_PROJECT
ELEVANT_API_CD_COMPOSE=/etc/dokploy/compose/REPLACE_API_RESOURCE/code/docker-compose.yml
ELEVANT_API_CD_ENV=/etc/dokploy/compose/REPLACE_API_RESOURCE/code/.env

ELEVANT_API_CD_STATE_DIR=/etc/dokploy/elevant/api-cd/state
ELEVANT_API_CD_LOG_DIR=/etc/dokploy/elevant/api-cd/log
ELEVANT_API_CD_LOCK_FILE=/etc/dokploy/elevant/api-cd/state/controller.lock
