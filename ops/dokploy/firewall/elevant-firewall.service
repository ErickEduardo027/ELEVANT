[Unit]
Description=ELEVANT public-interface firewall policy
Documentation=file:/usr/local/share/doc/elevant-firewall/README.md
Wants=network-online.target
After=network-online.target docker.service tailscaled.service
PartOf=docker.service tailscaled.service
ReloadPropagatedFrom=docker.service tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/sbin/elevant-firewall-apply --config /etc/elevant/firewall.env
ExecReload=/usr/bin/bash /usr/local/sbin/elevant-firewall-apply --config /etc/elevant/firewall.env
RemainAfterExit=yes
TimeoutStartSec=60
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock -/run/xtables.lock
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target docker.service tailscaled.service
