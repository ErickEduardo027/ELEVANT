# ELEVANT host firewall configuration.
#
# Copy this file to /etc/elevant/firewall.env with owner root:root and mode 0600.
# Values are parsed as data, not sourced as shell code. Do not add quotes or spaces.

# Public network interface used by every IPv4 and IPv6 default route.
ELEVANT_PUBLIC_INTERFACE=eth0

# Allowed values: transitional, final
# transitional: ICMP/ICMPv6, UDP 41641, TCP 22 and TCP 80 on the host;
#               only original TCP 80 connections may reach Docker-published ports.
# final:        ICMP/ICMPv6 and UDP 41641 on the host; no public Docker traffic.
ELEVANT_FIREWALL_PHASE=transitional
