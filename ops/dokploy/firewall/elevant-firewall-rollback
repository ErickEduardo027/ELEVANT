#!/usr/bin/env bash
set -Eeuo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly LOCK_FILE="/run/lock/elevant-firewall.lock"
readonly TABLE_FAMILY="inet"
readonly TABLE_NAME="elevant_firewall"
readonly TABLE_COMMENT="elevant-owned-firewall-v1"
readonly INPUT_CHAIN="public_input"
readonly FORWARD_CHAIN="public_forward"
readonly INPUT_CHAIN_COMMENT="elevant-owned-public-input-v1"
readonly FORWARD_CHAIN_COMMENT="elevant-owned-public-forward-v1"
readonly APPLY_UNIT="elevant-firewall.service"

CONFIG_FILE="/etc/elevant/firewall.env"
DRY_RUN=0
PUBLIC_INTERFACE=""
FIREWALL_PHASE=""
TABLE_PRESENT=0
NFT_BATCH=""
RESTORE_BATCH=""
APPLY_WAS_ENABLED=0
APPLY_WAS_ACTIVE=0
UNIT_STATE_CAPTURED=0
DEACTIVATION_ATTEMPTED=0
TABLE_DELETED=0
ROLLBACK_COMPLETE=0

log() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

usage() {
  cat <<'EOF'
Usage: elevant-firewall-rollback [--config ABSOLUTE_PATH] [--dry-run]

Removes only the exact, canonical ELEVANT-owned nftables inet table, verifies
its absence, and then disables the apply unit. It never flushes a ruleset or
changes Docker, Tailscale, iptables, or another nft table.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      --config)
        (( $# >= 2 )) || die "--config requires a path"
        CONFIG_FILE="$2"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

load_config() {
  [[ "$CONFIG_FILE" == /* ]] || die "configuration path must be absolute"
  [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || \
    die "configuration must be a regular, non-symlink file: $CONFIG_FILE"
  [[ -r "$CONFIG_FILE" ]] || die "configuration is not readable: $CONFIG_FILE"

  local metadata
  metadata="$(stat -c '%u:%a' -- "$CONFIG_FILE")" || \
    die "could not inspect configuration ownership and mode"
  [[ "$metadata" == "0:600" ]] || \
    die "configuration must be owned by UID 0 with exact mode 0600"

  local line key value line_number=0
  local seen_interface=0 seen_phase=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    (( line_number += 1 ))
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue

    if [[ ! "$line" =~ ^([A-Z][A-Z0-9_]*)=([^[:space:]#]+)$ ]]; then
      die "invalid configuration syntax at line $line_number"
    fi

    key="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    case "$key" in
      ELEVANT_PUBLIC_INTERFACE)
        (( seen_interface == 0 )) || die "duplicate setting: $key"
        PUBLIC_INTERFACE="$value"
        seen_interface=1
        ;;
      ELEVANT_FIREWALL_PHASE)
        (( seen_phase == 0 )) || die "duplicate setting: $key"
        FIREWALL_PHASE="$value"
        seen_phase=1
        ;;
      *)
        die "unsupported configuration setting at line $line_number: $key"
        ;;
    esac
  done < "$CONFIG_FILE"

  (( seen_interface == 1 && seen_phase == 1 )) || \
    die "configuration is missing one or more required settings"
  [[ "$PUBLIC_INTERFACE" =~ ^[[:alnum:]_.:-]{1,15}$ ]] || \
    die "invalid public interface name"
  [[ "$PUBLIC_INTERFACE" != "lo" && "$PUBLIC_INTERFACE" != "tailscale0" ]] || \
    die "the public interface cannot be lo or tailscale0"
  [[ "$FIREWALL_PHASE" == "transitional" || "$FIREWALL_PHASE" == "final" ]] || \
    die "ELEVANT_FIREWALL_PHASE must be transitional or final"
}

render_canonical_listing() {
  local phase="$1"

  cat <<EOF
table $TABLE_FAMILY $TABLE_NAME {
  comment "$TABLE_COMMENT"
  chain $INPUT_CHAIN {
    comment "$INPUT_CHAIN_COMMENT"
    type filter hook input priority filter - 10; policy accept;
    iifname "$PUBLIC_INTERFACE" ct state invalid drop comment "elevant-drop-invalid"
    iifname "$PUBLIC_INTERFACE" ct state { established, related } accept comment "elevant-allow-established"
    iifname "$PUBLIC_INTERFACE" ip protocol icmp accept comment "elevant-allow-icmp"
    iifname "$PUBLIC_INTERFACE" meta l4proto ipv6-icmp accept comment "elevant-allow-icmpv6"
    iifname "$PUBLIC_INTERFACE" udp dport 41641 accept comment "elevant-allow-tailscale-direct"
EOF

  if [[ "$phase" == "transitional" ]]; then
    cat <<EOF
    iifname "$PUBLIC_INTERFACE" ct state new tcp dport { 22, 80 } accept comment "elevant-temporary-tcp"
EOF
  fi

  cat <<EOF
    iifname "$PUBLIC_INTERFACE" drop comment "elevant-public-default-deny"
  }
  chain $FORWARD_CHAIN {
    comment "$FORWARD_CHAIN_COMMENT"
    type filter hook forward priority filter - 10; policy accept;
    iifname "$PUBLIC_INTERFACE" ct state invalid drop comment "elevant-forward-drop-invalid"
    iifname "$PUBLIC_INTERFACE" ct state { established, related } accept comment "elevant-forward-allow-established"
EOF

  if [[ "$phase" == "transitional" ]]; then
    cat <<EOF
    iifname "$PUBLIC_INTERFACE" ct state new ct direction original ct status dnat meta l4proto tcp ct original proto-dst 80 accept comment "elevant-forward-temporary-http"
EOF
  fi

  cat <<EOF
    iifname "$PUBLIC_INTERFACE" drop comment "elevant-forward-default-deny"
  }
}
EOF
}

normalize_listing() {
  awk 'NF { $1 = $1; print }'
}

validate_owned_table() {
  local tables current_raw current expected_transitional expected_final
  local -a families=()

  tables="$(nft list tables)" || die "could not list nft tables"
  mapfile -t families < <(
    awk -v table_name="$TABLE_NAME" '
      $1 == "table" && $3 == table_name { print $2 }
    ' <<< "$tables"
  )
  if (( ${#families[@]} == 0 )); then
    TABLE_PRESENT=0
    return 0
  fi

  if (( ${#families[@]} != 1 )) || [[ "${families[0]}" != "$TABLE_FAMILY" ]]; then
    die "table name $TABLE_NAME exists in an unexpected family or more than once"
  fi

  current_raw="$(nft list table "$TABLE_FAMILY" "$TABLE_NAME")" || \
    die "could not inspect existing ELEVANT nft table"
  current="$(normalize_listing <<< "$current_raw")"
  expected_transitional="$(render_canonical_listing transitional | normalize_listing)"
  expected_final="$(render_canonical_listing final | normalize_listing)"

  if [[ "$current" != "$expected_transitional" && "$current" != "$expected_final" ]]; then
    die "existing nft table $TABLE_FAMILY $TABLE_NAME is not an exact ELEVANT-owned policy; refusing to delete it"
  fi

  TABLE_PRESENT=1
  RESTORE_BATCH="$current_raw"
}

query_unit_state() {
  local operation="$1" state status=0

  if state="$(systemctl "$operation" "$APPLY_UNIT" 2>/dev/null)"; then
    status=0
  else
    status=$?
  fi

  [[ -n "$state" ]] || \
    die "could not query $operation for $APPLY_UNIT (systemctl exit $status)"
  printf '%s\n' "$state"
}

capture_apply_unit_state() {
  local active_state enabled_state

  active_state="$(query_unit_state is-active)"
  enabled_state="$(query_unit_state is-enabled)"
  UNIT_STATE_CAPTURED=1

  case "$active_state" in
    inactive|failed|unknown)
      ;;
    *)
      APPLY_WAS_ACTIVE=1
      ;;
  esac

  case "$enabled_state" in
    disabled|masked|masked-runtime|not-found)
      ;;
    *)
      case "$enabled_state" in
        enabled|enabled-runtime|linked|linked-runtime|alias)
          APPLY_WAS_ENABLED=1
          ;;
      esac
      ;;
  esac
}

deactivate_apply_unit() {
  local active_state enabled_state needs_deactivation=0

  (( UNIT_STATE_CAPTURED )) || die "internal error: apply unit state was not captured"
  (( APPLY_WAS_ACTIVE || APPLY_WAS_ENABLED )) && needs_deactivation=1

  if (( needs_deactivation )); then
    if (( DRY_RUN )); then
      printf 'DRY-RUN: systemctl disable --now %q\n' "$APPLY_UNIT"
    else
      DEACTIVATION_ATTEMPTED=1
      systemctl disable --now "$APPLY_UNIT"
    fi
  fi

  if (( ! DRY_RUN )); then
    active_state="$(query_unit_state is-active)"
    enabled_state="$(query_unit_state is-enabled)"

    case "$active_state" in
      inactive|failed|unknown)
        ;;
      *)
        die "$APPLY_UNIT remains $active_state; refusing to remove firewall policy"
        ;;
    esac
    case "$enabled_state" in
      disabled|masked|masked-runtime|not-found)
        ;;
      *)
        die "$APPLY_UNIT remains $enabled_state; refusing to remove firewall policy"
        ;;
    esac
  fi
}

recover_apply_unit_on_failure() {
  local status=$?

  trap - EXIT
  if (( status == 0 || ROLLBACK_COMPLETE )); then
    exit "$status"
  fi

  if (( TABLE_DELETED )); then
    log "rollback failed after deleting the table; restoring the validated prior policy"
    if ! printf '%s\n' "$RESTORE_BATCH" | nft --check -f - ||
       ! printf '%s\n' "$RESTORE_BATCH" | nft -f -; then
      log "CRITICAL: could not restore the ELEVANT nft table; repair it from the provider console"
    fi
  fi

  if (( ! UNIT_STATE_CAPTURED || ! DEACTIVATION_ATTEMPTED )); then
    exit "$status"
  fi

  log "restoring the apply unit's prior lifecycle state"
  flock -u 9 || true

  if (( APPLY_WAS_ENABLED )); then
    if ! systemctl enable "$APPLY_UNIT"; then
      log "CRITICAL: could not re-enable $APPLY_UNIT; repair it from the provider console"
    fi
  fi
  if (( APPLY_WAS_ACTIVE )); then
    if ! systemctl start "$APPLY_UNIT"; then
      log "CRITICAL: could not restart $APPLY_UNIT; repair it from the provider console"
    fi
  fi

  exit "$status"
}

build_batch() {
  NFT_BATCH="delete table $TABLE_FAMILY $TABLE_NAME"
}

check_batch() {
  printf '%s\n' "$NFT_BATCH" | nft --check -f - || \
    die "nft rejected the exact rollback transaction"
}

assert_table_absent() {
  local tables

  tables="$(nft list tables)" || die "could not verify nft tables after rollback"
  if awk -v table_name="$TABLE_NAME" '
       $1 == "table" && $3 == table_name { found = 1 }
       END { exit(found ? 0 : 1) }
     ' <<< "$tables"; then
    die "ELEVANT nft table name remains after rollback"
  fi
}

main() {
  parse_args "$@"
  (( EUID == 0 )) || die "must run as root"
  require_command stat
  load_config

  require_command awk
  require_command flock
  require_command nft
  require_command systemctl

  exec 9>"$LOCK_FILE"
  flock -n 9 || die "another ELEVANT firewall operation is running"

  validate_owned_table
  log "removing ELEVANT nft policy for interface=$PUBLIC_INTERFACE dry_run=$DRY_RUN"

  # Prove the exact deletion transaction before changing service lifecycle.
  if (( TABLE_PRESENT )); then
    build_batch
    check_batch
  fi
  capture_apply_unit_state

  trap recover_apply_unit_on_failure EXIT

  if (( TABLE_PRESENT )); then
    if (( DRY_RUN )); then
      printf 'DRY-RUN: %s\n' "$NFT_BATCH"
    else
      printf '%s\n' "$NFT_BATCH" | nft -f - || \
        die "atomic nft rollback failed; the ELEVANT table was retained"
      TABLE_DELETED=1
      assert_table_absent
    fi
  else
    log "ELEVANT nft table is already absent"
  fi

  # Delete first while the unit is still enabled. A power loss at any earlier
  # point therefore reapplies the policy at boot. If deactivation fails after
  # deletion, the EXIT trap restores both table and lifecycle state.
  deactivate_apply_unit

  ROLLBACK_COMPLETE=1
  trap - EXIT
  log "rollback completed successfully"
}

main "$@"
