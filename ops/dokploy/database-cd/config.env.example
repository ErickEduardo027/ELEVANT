# Replace every REPLACE_* value in the restricted installed copy only.
# Keep this repository example secret-free.
ELEVANT_CD_MANIFEST_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-release-manifest
ELEVANT_CD_MANIFEST_ALIAS=development-certified
ELEVANT_CD_EXPECTED_REPOSITORY=REPLACE_OWNER/REPLACE_REPOSITORY
ELEVANT_CD_EXPECTED_REF=refs/heads/Development
ELEVANT_CD_OPS_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-ops
ELEVANT_CD_RELEASE_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-db-release

# Paths below are paths inside the private Dokploy container. The database and
# release resources retain separate Compose projects while sharing one SQL DB.
ELEVANT_CD_DOCKER_CONFIG=/root/.docker
ELEVANT_CD_DATABASE_PROJECT=REPLACE_DATABASE_COMPOSE_PROJECT
ELEVANT_CD_DATABASE_COMPOSE=/etc/dokploy/compose/REPLACE_DATABASE_RESOURCE/code/docker-compose.yml
ELEVANT_CD_DATABASE_ENV=/etc/dokploy/compose/REPLACE_DATABASE_RESOURCE/code/.env
ELEVANT_CD_RELEASE_PROJECT=REPLACE_RELEASE_COMPOSE_PROJECT
ELEVANT_CD_RELEASE_COMPOSE=/etc/dokploy/compose/REPLACE_RELEASE_RESOURCE/code/docker-compose.yml
ELEVANT_CD_RELEASE_ENV=/etc/dokploy/compose/REPLACE_RELEASE_RESOURCE/code/.env

# These paths must remain in Dokploy's persistent /etc/dokploy bind mount.
ELEVANT_CD_STATE_DIR=/etc/dokploy/elevant/database-cd/state
ELEVANT_CD_LOG_DIR=/etc/dokploy/elevant/database-cd/log
ELEVANT_CD_LOCK_FILE=/etc/dokploy/elevant/database-cd/state/controller.lock

# Optional. Leave empty to disable commit status reporting. If configured, this
# file contains only a fine-grained token with Metadata:read and Commit
# statuses:write for this repository, owned by root with exact mode 0600.
ELEVANT_CD_GITHUB_TOKEN_FILE=
ELEVANT_CD_GITHUB_API_URL=https://api.github.com
