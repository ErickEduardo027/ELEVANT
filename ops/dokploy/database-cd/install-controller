#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly PROGRAM_NAME="${0##*/}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
DESTINATION="/etc/dokploy/elevant/database-cd"
TEST_MODE="${ELEVANT_CD_INSTALL_TEST_MODE:-0}"
TEST_ROOT="${ELEVANT_CD_INSTALL_TEST_ROOT:-}"
EXPECTED_UID=0
EXPECTED_GID=0
TEST_PERMISSIONS_EMULATED=0

die() {
  printf '%s: ERROR: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: install-controller [--destination ABSOLUTE_PATH]

Installs the reviewed, secret-free database CD controller into Dokploy's
persistent /etc/dokploy bind. It never enables a schedule, deploys a release,
edits a Dokploy resource, writes a token, or replaces an existing config.env.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --destination)
      (( $# >= 2 )) || die "--destination requires a path"
      DESTINATION="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [[ "$TEST_MODE" == "1" ]]; then
  [[ "$TEST_ROOT" == /* && -d "$TEST_ROOT" && ! -L "$TEST_ROOT" ]] || \
    die "test root must be an existing absolute, non-symlink directory"
  [[ "$DESTINATION" == "$TEST_ROOT/etc/dokploy/elevant/database-cd" ]] || \
    die "test destination must remain below the explicit test root"
  EXPECTED_UID="$(id -u)"
  EXPECTED_GID="$(id -g)"
  case "$(uname -s)" in
    MINGW*|MSYS*) TEST_PERMISSIONS_EMULATED=1 ;;
  esac
else
  (( EUID == 0 )) || die "must run as root on the Development VPS"
  [[ "$DESTINATION" == /etc/dokploy/elevant/database-cd ]] || \
    die "destination must be /etc/dokploy/elevant/database-cd"
fi

DOKPLOY_ROOT="$(dirname -- "$(dirname -- "$DESTINATION")")"
[[ -d "$DOKPLOY_ROOT" && ! -L "$DOKPLOY_ROOT" ]] || \
  die "Dokploy persistent bind is unavailable"

for source_file in elevant-database-cd manifest-tool.mjs state-tool.mjs \
  verify-runtime config.env.example README.md jobs/poll.job.sh \
  jobs/backup.job.sh jobs/restore-check.job.sh; do
  [[ -f "$SCRIPT_DIR/$source_file" && ! -L "$SCRIPT_DIR/$source_file" ]] || \
    die "missing installation source: $source_file"
done

install_directory() {
  local destination="$1"
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -d "$destination" && ! -L "$destination" ]] || \
      die "refusing unsafe installation directory: $destination"
  fi
  if [[ "$TEST_MODE" == "1" ]]; then
    mkdir -p -- "$destination"
    chmod 0700 -- "$destination"
  else
    install -d -o root -g root -m 0700 -- "$destination"
  fi
}

install_file() {
  local mode="$1" source="$2" destination="$3"
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] || \
      die "refusing unsafe installation file: $destination"
  fi
  if [[ "$TEST_MODE" == "1" ]]; then
    install -m "$mode" -- "$source" "$destination"
  else
    install -o root -g root -m "$mode" -- "$source" "$destination"
  fi
}

ELEVANT_ROOT="$DOKPLOY_ROOT/elevant"
for runtime_directory in "$ELEVANT_ROOT" "$DESTINATION" "$DESTINATION/state" \
  "$DESTINATION/state/attempts" "$DESTINATION/state/tmp" \
  "$DESTINATION/log" "$DESTINATION/jobs"; do
  install_directory "$runtime_directory"
done
install_file 0555 "$SCRIPT_DIR/elevant-database-cd" \
  "$DESTINATION/elevant-database-cd"
install_file 0555 "$SCRIPT_DIR/manifest-tool.mjs" \
  "$DESTINATION/manifest-tool.mjs"
install_file 0555 "$SCRIPT_DIR/state-tool.mjs" "$DESTINATION/state-tool.mjs"
install_file 0555 "$SCRIPT_DIR/verify-runtime" "$DESTINATION/verify-runtime"
install_file 0444 "$SCRIPT_DIR/config.env.example" \
  "$DESTINATION/config.env.example"
install_file 0444 "$SCRIPT_DIR/README.md" "$DESTINATION/README.md"
install_file 0555 "$SCRIPT_DIR/jobs/poll.job.sh" \
  "$DESTINATION/jobs/poll.job.sh"
install_file 0555 "$SCRIPT_DIR/jobs/backup.job.sh" \
  "$DESTINATION/jobs/backup.job.sh"
install_file 0555 "$SCRIPT_DIR/jobs/restore-check.job.sh" \
  "$DESTINATION/jobs/restore-check.job.sh"

if [[ ! -e "$DESTINATION/config.env" ]]; then
  install_file 0600 "$SCRIPT_DIR/config.env.example" "$DESTINATION/config.env"
  printf '%s\n' \
    "Installed placeholder config.env; replace every REPLACE_* value before validation."
else
  [[ -f "$DESTINATION/config.env" && ! -L "$DESTINATION/config.env" ]] || \
    die "existing config.env is not a regular, non-symlink file"
  if (( ! TEST_PERMISSIONS_EMULATED )); then
    [[ "$(stat -c '%u:%g:%a' -- "$DESTINATION/config.env")" == \
        "$EXPECTED_UID:$EXPECTED_GID:600" ]] || \
      die "existing config.env has invalid ownership or mode"
  fi
  printf '%s\n' "Preserved existing config.env."
fi

verify_installed() {
  local kind="$1" mode="$2" path="$3"
  if [[ "$kind" == "directory" ]]; then
    [[ -d "$path" && ! -L "$path" ]] || \
      die "installed inventory is missing directory: $path"
  else
    [[ -f "$path" && ! -L "$path" ]] || \
      die "installed inventory is missing file: $path"
  fi
  (( TEST_PERMISSIONS_EMULATED )) && return 0
  [[ "$(stat -c '%u:%g:%a' -- "$path")" == \
      "$EXPECTED_UID:$EXPECTED_GID:$mode" ]] || \
    die "installed inventory has invalid ownership or mode: $path"
}

for runtime_directory in "$ELEVANT_ROOT" "$DESTINATION" "$DESTINATION/state" \
  "$DESTINATION/state/attempts" "$DESTINATION/state/tmp" \
  "$DESTINATION/log" "$DESTINATION/jobs"; do
  verify_installed directory 700 "$runtime_directory"
done
for executable_file in elevant-database-cd manifest-tool.mjs state-tool.mjs \
  verify-runtime jobs/poll.job.sh jobs/backup.job.sh jobs/restore-check.job.sh; do
  verify_installed file 555 "$DESTINATION/$executable_file"
done
verify_installed file 444 "$DESTINATION/config.env.example"
verify_installed file 444 "$DESTINATION/README.md"
verify_installed file 600 "$DESTINATION/config.env"

bash -n "$DESTINATION/elevant-database-cd"
/bin/sh -n "$DESTINATION/jobs/poll.job.sh"
/bin/sh -n "$DESTINATION/jobs/backup.job.sh"
/bin/sh -n "$DESTINATION/jobs/restore-check.job.sh"
printf '%s\n' \
  "Controller files installed; run verify-runtime next. No schedule or deployment was enabled."
