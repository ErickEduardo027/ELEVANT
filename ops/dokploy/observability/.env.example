# URL HTTPS exacta que devuelve Tailscale para svc:elevant-dev-monitoring.
BESZEL_APP_URL=https://REPLACE_WITH_TAILSCALE_SERVICE_FQDN

# URL secreta de ping creada en Healthchecks.io. No guarde el valor real en este archivo.
BESZEL_HEARTBEAT_URL=https://hc-ping.com/REPLACE_WITH_HEALTHCHECK_UUID

# Valores generados por el dialogo Add System de Beszel. La clave es publica; el token es secreto.
BESZEL_AGENT_KEY="ssh-ed25519 REPLACE_WITH_PUBLIC_KEY_FROM_BESZEL"
BESZEL_AGENT_TOKEN=REPLACE_WITH_SYSTEM_TOKEN_FROM_BESZEL

# Opcional. Deje vacio para autodeteccion; defina el dispositivo solo si Beszel identifica mal /.
BESZEL_FILESYSTEM=
