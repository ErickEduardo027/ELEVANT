PROFILE_HEALTH_PATH=""
PROFILE_SMOKE_PATHS=""
MANIFEST_PATH=""
ARTIFACT_STAGING_DIR=""
LOG_READY=0

log() {
  local timestamp message log_size identity="$PROGRAM_NAME${APPLICATION:+[$APPLICATION]}"
  message="$*"; timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf '%s %s: %s\n' "$timestamp" "$identity" "$message" >&2
  if (( LOG_READY )); then
    log_size="$(stat -c '%s' -- "$CD_LOG_DIR/controller.log")"
    if (( log_size >= 10485760 )); then
      mv -fT -- "$CD_LOG_DIR/controller.log" "$CD_LOG_DIR/controller.log.1"
      touch -- "$CD_LOG_DIR/controller.log"
      chmod 0600 -- "$CD_LOG_DIR/controller.log" "$CD_LOG_DIR/controller.log.1"
    fi
    printf '%s %s: %s\n' "$timestamp" "$identity" "$message" >> "$CD_LOG_DIR/controller.log"
  fi
}

die() { log "ERROR: $*"; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
set_command() { [[ -z "$COMMAND" ]] || die "only one command may be selected"; COMMAND="$1"; }

usage() {
  cat <<'EOF'
Usage:
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --poll
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --dry-run
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --retry sha256:DIGEST
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --promote-with-rollback-drill sha256:DIGEST
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --adopt-current
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --status
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --pause
  elevant-web-cd --app aviam-web|public-web [--config ABSOLUTE_PATH] --resume

The controller deploys one certified Development web bundle by immutable digest.
It requires the exact certified API manifest, image and OpenAPI contract. Failed
digests stop automatically; deployment failure restores the last healthy image
and certified Compose, and rollback failure pauses only the selected profile.
EOF
}

parse_args() {
  while (( $# > 0 )); do
    case "$1" in
      --app) (( $# >= 2 )) || die "--app requires a value"; [[ -z "$APPLICATION" ]] || die "--app may be supplied only once"; APPLICATION="$2"; shift 2 ;;
      --config) (( $# >= 2 )) || die "--config requires a path"; [[ -z "$CONFIG_FILE" ]] || die "--config may be supplied only once"; CONFIG_FILE="$2"; shift 2 ;;
      --poll|--dry-run|--adopt-current|--status|--pause|--resume) set_command "${1#--}"; shift ;;
      --retry) (( $# >= 2 )) || die "--retry requires a sha256 digest"; set_command retry; REQUESTED_DIGEST="$2"; shift 2 ;;
      --promote-with-rollback-drill) (( $# >= 2 )) || die "--promote-with-rollback-drill requires a sha256 digest"; set_command promote-with-rollback-drill; REQUESTED_DIGEST="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ "$APPLICATION" == aviam-web || "$APPLICATION" == public-web ]] || die "--app must be aviam-web or public-web"
  [[ -n "$COMMAND" ]] || die "a command is required"
  [[ -n "$CONFIG_FILE" ]] || CONFIG_FILE="/etc/dokploy/elevant/web-cd/config.$APPLICATION.env"
  if [[ -n "$REQUESTED_DIGEST" ]]; then
    [[ "$REQUESTED_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || die "requested manifest digest has an invalid format"
  fi
}

configure_profile_contract() {
  case "$APPLICATION" in
    aviam-web)
      PROFILE_CONTAINER_PORT=8080
      PROFILE_HEALTH_PATH=/healthz
      PROFILE_SMOKE_PATHS='["/healthz","/","/dashboard"]'
      ;;
    public-web)
      PROFILE_CONTAINER_PORT=3000
      PROFILE_HEALTH_PATH=/health
      PROFILE_SMOKE_PATHS='["/health","/","/login"]'
      ;;
    *) die "internal application profile error" ;;
  esac
}

assign_config_value() {
  local key="$1" value="$2"
  case "$key" in
    ELEVANT_WEB_CD_APPLICATION) CD_APPLICATION="$value" ;;
    ELEVANT_WEB_CD_MANIFEST_REPOSITORY) CD_MANIFEST_REPOSITORY="$value" ;;
    ELEVANT_WEB_CD_MANIFEST_ALIAS) CD_MANIFEST_ALIAS="$value" ;;
    ELEVANT_WEB_CD_EXPECTED_REPOSITORY) CD_EXPECTED_REPOSITORY="$value" ;;
    ELEVANT_WEB_CD_EXPECTED_REF) CD_EXPECTED_REF="$value" ;;
    ELEVANT_WEB_CD_WEB_REPOSITORY) CD_WEB_REPOSITORY="$value" ;;
    ELEVANT_WEB_CD_API_MANIFEST_REPOSITORY) CD_API_MANIFEST_REPOSITORY="$value" ;;
    ELEVANT_WEB_CD_API_IMAGE_REPOSITORY) CD_API_IMAGE_REPOSITORY="$value" ;;
    ELEVANT_WEB_CD_API_STATE) CD_API_STATE="$value" ;;
    ELEVANT_WEB_CD_API_LOCK) CD_API_LOCK="$value" ;;
    ELEVANT_WEB_CD_API_PROJECT) CD_API_PROJECT="$value" ;;
    ELEVANT_WEB_CD_API_SERVICE) CD_API_SERVICE="$value" ;;
    ELEVANT_WEB_CD_API_CONTAINER_PORT) CD_API_CONTAINER_PORT="$value" ;;
    ELEVANT_WEB_CD_API_OPENAPI_PATH) CD_API_OPENAPI_PATH="$value" ;;
    ELEVANT_WEB_CD_HTTP_PROBE_IMAGE) CD_HTTP_PROBE_IMAGE="$value" ;;
    ELEVANT_WEB_CD_EXPECTED_API_ORIGIN) CD_EXPECTED_API_ORIGIN="$value" ;;
    ELEVANT_WEB_CD_DATABASE_LOCK) CD_DATABASE_LOCK="$value" ;;
    ELEVANT_WEB_CD_DOCKER_CONFIG) CD_DOCKER_CONFIG="$value" ;;
    ELEVANT_WEB_CD_PROJECT) CD_PROJECT="$value" ;;
    ELEVANT_WEB_CD_COMPOSE) CD_COMPOSE="$value" ;;
    ELEVANT_WEB_CD_ENV) CD_ENV="$value" ;;
    ELEVANT_WEB_CD_SERVICE) CD_SERVICE="$value" ;;
    ELEVANT_WEB_CD_IMAGE_ENV) CD_IMAGE_ENV="$value" ;;
    ELEVANT_WEB_CD_STATE_DIR) CD_STATE_DIR="$value" ;;
    ELEVANT_WEB_CD_LOG_DIR) CD_LOG_DIR="$value" ;;
    ELEVANT_WEB_CD_GLOBAL_LOCK) CD_GLOBAL_LOCK="$value" ;;
    ELEVANT_WEB_CD_LOCK_FILE) CD_LOCK_FILE="$value" ;;
    *) die "unsupported configuration setting: $key" ;;
  esac
}

load_config() {
  [[ "$CONFIG_FILE" == /* && -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]] || die "configuration must be an absolute regular, non-symlink file"
  local expected_uid=0 metadata line key value line_number=0
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  metadata="$(stat -c '%u:%a' -- "$CONFIG_FILE")"
  [[ "$metadata" == "$expected_uid:600" ]] || die "configuration must be owned by the controller UID with exact mode 0600"
  declare -A seen=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    (( line_number += 1 )); line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=([^[:space:]#]*)$ ]] || die "invalid configuration syntax at line $line_number"
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    [[ -z "${seen[$key]:-}" ]] || die "duplicate configuration setting: $key"
    seen[$key]=1; assign_config_value "$key" "$value"
  done < "$CONFIG_FILE"
  local required
  for required in CD_APPLICATION CD_MANIFEST_REPOSITORY CD_MANIFEST_ALIAS CD_EXPECTED_REPOSITORY CD_EXPECTED_REF CD_WEB_REPOSITORY CD_API_MANIFEST_REPOSITORY CD_API_IMAGE_REPOSITORY CD_API_STATE CD_API_LOCK CD_API_PROJECT CD_API_SERVICE CD_API_CONTAINER_PORT CD_API_OPENAPI_PATH CD_HTTP_PROBE_IMAGE CD_EXPECTED_API_ORIGIN CD_DATABASE_LOCK CD_DOCKER_CONFIG CD_PROJECT CD_COMPOSE CD_ENV CD_SERVICE CD_IMAGE_ENV CD_STATE_DIR CD_LOG_DIR CD_GLOBAL_LOCK CD_LOCK_FILE; do
    [[ -n "${!required}" ]] || die "missing required configuration value: $required"
    [[ "${!required}" != *REPLACE_* ]] || die "configuration still contains a placeholder"
  done
  [[ "$CD_APPLICATION" == "$APPLICATION" ]] || die "configuration application does not match --app"
  local repository
  for repository in "$CD_MANIFEST_REPOSITORY" "$CD_WEB_REPOSITORY" "$CD_API_MANIFEST_REPOSITORY" "$CD_API_IMAGE_REPOSITORY"; do
    [[ "$repository" =~ ^ghcr\.io/[a-z0-9._-]+/[a-z0-9._-]+$ ]] || die "invalid lowercase GHCR repository"
  done
  [[ "$CD_MANIFEST_ALIAS" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid manifest alias"
  [[ "$CD_EXPECTED_REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid expected GitHub repository"
  [[ "$CD_EXPECTED_REF" == refs/heads/Development ]] || die "only refs/heads/Development is supported"
  [[ "$CD_PROJECT" =~ ^[a-z0-9][a-z0-9_-]+$ ]] || die "invalid Compose project"
  [[ "$CD_API_PROJECT" =~ ^[a-z0-9][a-z0-9_-]+$ ]] || die "invalid API Compose project"
  [[ "$CD_API_SERVICE" == api ]] || die "API Compose service must be api"
  [[ "$CD_API_CONTAINER_PORT" == 8080 ]] || die "API container port must be 8080"
  [[ "$CD_API_OPENAPI_PATH" == /swagger/v1/swagger.json ]] || die "API OpenAPI path must be the v1 Swagger path"
  [[ "$CD_HTTP_PROBE_IMAGE" =~ ^docker\.io/curlimages/curl@sha256:[0-9a-f]{64}$ ]] || die "HTTP probe image must be the reviewed curl image pinned by digest"
  "$NODE_BIN" -e '
    const raw = process.argv[1];
    let value;
    try { value = new URL(raw); } catch { process.exit(1); }
    const host = value.hostname.toLowerCase().replace(/\.$/, "");
    const loopback = host === "localhost" || host.endsWith(".localhost") ||
      host === "127.0.0.1" || host.startsWith("127.") ||
      host === "[::1]" || host === "::1" || host === "0.0.0.0" ||
      host === "[::]" || host === "::";
    if (value.protocol !== "https:" || value.username || value.password ||
        value.pathname !== "/" || value.search || value.hash ||
        value.origin !== raw || loopback) process.exit(1);
  ' "$CD_EXPECTED_API_ORIGIN" || die "expected API origin must be one exact non-loopback HTTPS origin without a trailing slash"
  local expected_service expected_key
  if [[ "$APPLICATION" == aviam-web ]]; then expected_service=aviam-web; expected_key=ELEVANT_AVIAM_WEB_IMAGE; else expected_service=public-web; expected_key=ELEVANT_PUBLIC_WEB_IMAGE; fi
  [[ "$CD_SERVICE" == "$expected_service" ]] || die "configured service does not match application"
  [[ "$CD_IMAGE_ENV" == "$expected_key" ]] || die "configured image environment key does not match application"
  local absolute
  for absolute in "$CD_API_STATE" "$CD_API_LOCK" "$CD_DATABASE_LOCK" "$CD_DOCKER_CONFIG" "$CD_COMPOSE" "$CD_ENV" "$CD_STATE_DIR" "$CD_LOG_DIR" "$CD_GLOBAL_LOCK" "$CD_LOCK_FILE"; do
    [[ "$absolute" == /* ]] || die "every configured filesystem path must be absolute"
  done
  [[ "$(basename -- "$CD_STATE_DIR")" == "$APPLICATION" ]] || die "profile state directory must end with the application name"
  [[ "$CD_LOCK_FILE" == "$CD_STATE_DIR/controller.lock" ]] || die "profile lock must use its canonical state path"
  [[ "$CD_DATABASE_LOCK" == "$CANONICAL_DATABASE_LOCK" ]] || die "database lock must use the canonical Database CD path"
  [[ "$CD_API_LOCK" == "$CANONICAL_API_LOCK" ]] || die "API lock must use the canonical API CD path"
  [[ "$CD_GLOBAL_LOCK" == "$CANONICAL_GLOBAL_LOCK" ]] || die "global web lock must use the canonical shared path"
  local -a locks=("$CD_DATABASE_LOCK" "$CD_API_LOCK" "$CD_GLOBAL_LOCK" "$CD_LOCK_FILE")
  local left right
  for (( left=0; left<${#locks[@]}; left+=1 )); do
    for (( right=left+1; right<${#locks[@]}; right+=1 )); do
      [[ "${locks[$left]}" != "${locks[$right]}" ]] || die "all controller locks must be pairwise distinct"
    done
  done
  [[ "$WAIT_ATTEMPTS" =~ ^[1-9][0-9]*$ && "$WAIT_INTERVAL" =~ ^[0-9]+$ ]] || die "invalid health wait configuration"
}

ensure_runtime_directories() {
  local expected_uid=0 directory metadata
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  for directory in "$(dirname -- "$CD_STATE_DIR")" "$CD_STATE_DIR" "$CD_STATE_DIR/attempts" "$CD_STATE_DIR/tmp" "$CD_STATE_DIR/compose" "$CD_STATE_DIR/compose/web" "$CD_LOG_DIR"; do
    [[ -e "$directory" ]] || install -d -m 0700 -- "$directory"
    [[ -d "$directory" && ! -L "$directory" ]] || die "runtime path must be a non-symlink directory: $directory"
    metadata="$(stat -c '%u:%a' -- "$directory")"
    [[ "$metadata" == "$expected_uid:700" ]] || die "runtime directories must be owned by the controller UID with mode 0700"
  done
  [[ -e "$CD_LOG_DIR/controller.log" ]] || touch -- "$CD_LOG_DIR/controller.log"
  [[ -f "$CD_LOG_DIR/controller.log" && ! -L "$CD_LOG_DIR/controller.log" ]] || die "controller log is unsafe"
  chmod 0600 -- "$CD_LOG_DIR/controller.log"; LOG_READY=1
}

validate_restricted_file() {
  local path="$1" expected_uid=0 metadata
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  [[ -f "$path" && ! -L "$path" ]] || die "restricted file must be regular and non-symlink: $path"
  metadata="$(stat -c '%u:%a' -- "$path")"
  [[ "$metadata" == "$expected_uid:600" ]] || die "restricted file must be owned by the controller UID with mode 0600: $path"
}

validate_runtime_files() {
  local path
  for path in "$STATE_TOOL" "$MANIFEST_TOOL" "$COMPOSE_MODEL_TOOL" "$OPENAPI_TOOL" "$ENV_TOOL"; do
    [[ -f "$path" && ! -L "$path" ]] || die "required runtime helper is unavailable"
  done
  case "$COMMAND" in status|pause|resume) return ;; esac
  [[ -f "$CD_COMPOSE" && ! -L "$CD_COMPOSE" ]] || die "live web Compose is unavailable"
  validate_restricted_file "$CD_ENV"; validate_restricted_file "$CD_API_STATE"
  [[ -d "$CD_DOCKER_CONFIG" && ! -L "$CD_DOCKER_CONFIG" ]] || die "Docker configuration directory is unavailable"
  docker_command version >/dev/null || die "Docker daemon is unavailable"
  docker_command compose version >/dev/null || die "Docker Compose plugin is unavailable"
}

ensure_lock_file() {
  local path="$1" expected_uid=0 metadata
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  [[ -d "$(dirname -- "$path")" && ! -L "$(dirname -- "$path")" ]] || die "lock parent directory is unavailable"
  [[ -e "$path" ]] || (umask 077; : > "$path")
  [[ -f "$path" && ! -L "$path" ]] || die "lock path must be a regular, non-symlink file"
  metadata="$(stat -c '%u:%a' -- "$path")"; [[ "$metadata" == "$expected_uid:600" ]] || die "lock file must be owned by the controller UID with mode 0600"
}

acquire_locks() {
  # Global protocol order: database -> API -> all-web -> selected profile.
  ensure_lock_file "$CD_DATABASE_LOCK"; exec 7<>"$CD_DATABASE_LOCK"; flock -n 7 || die "another ELEVANT database operation is running"
  ensure_lock_file "$CD_API_LOCK"; exec 8<>"$CD_API_LOCK"; flock -n 8 || die "another ELEVANT API operation is running"
  ensure_lock_file "$CD_GLOBAL_LOCK"; exec 9<>"$CD_GLOBAL_LOCK"; flock -n 9 || die "another ELEVANT web operation is running"
  ensure_lock_file "$CD_LOCK_FILE"; exec 10<>"$CD_LOCK_FILE"; flock -n 10 || die "another $APPLICATION operation is running"
}

docker_command() { DOCKER_CONFIG="$CD_DOCKER_CONFIG" "$DOCKER_BIN" "$@"; }
manifest_ref() { printf '%s:%s\n' "$CD_MANIFEST_REPOSITORY" "$CD_MANIFEST_ALIAS"; }
image_label() { docker_command image inspect --format "{{index .Config.Labels \"$2\"}}" "$1"; }

resolve_alias_digest() {
  local alias_ref output candidate match=""
  alias_ref="$(manifest_ref)"; docker_command pull "$alias_ref" >/dev/null || die "could not pull the certified $APPLICATION manifest alias"
  output="$(docker_command image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$alias_ref")" || die "could not inspect the web manifest alias"
  while IFS= read -r candidate; do
    [[ "$candidate" == "$CD_MANIFEST_REPOSITORY@"* && "${candidate#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] || continue
    [[ -z "$match" || "$match" == "$candidate" ]] || die "manifest alias resolved to multiple repository digests"
    match="$candidate"
  done <<< "$output"
  [[ -n "$match" ]] || die "manifest alias did not resolve to an immutable digest"
  printf '%s\n' "${match#*@}"
}

extract_web_bundle() {
  local digest="$1" image_ref container_id staging path size
  image_ref="$CD_MANIFEST_REPOSITORY@$digest"; docker_command pull "$image_ref" >/dev/null || die "could not pull the immutable web bundle"
  staging="$(mktemp -d "$CD_STATE_DIR/tmp/web-bundle.XXXXXX")"; chmod 0700 -- "$staging"; ARTIFACT_STAGING_DIR="$staging"
  container_id="$(docker_command create "$image_ref")" || die "could not create web bundle extraction container"
  if [[ ! "$container_id" =~ ^[0-9a-f]{64}$ ]]; then
    [[ -z "$container_id" ]] || docker_command rm -f "$container_id" >/dev/null 2>&1 || true
    die "web bundle extraction returned an invalid container ID"
  fi
  if ! docker_command cp "$container_id:/manifest.json" "$staging/manifest.json" >/dev/null || ! docker_command cp "$container_id:$OCI_WEB_COMPOSE" "$staging/compose.development.web.yml" >/dev/null; then
    docker_command rm -f "$container_id" >/dev/null 2>&1 || true; die "could not extract every web bundle payload"
  fi
  docker_command rm -f "$container_id" >/dev/null || die "could not remove web bundle extraction container"
  for path in "$staging/manifest.json" "$staging/compose.development.web.yml"; do
    [[ -f "$path" && ! -L "$path" ]] || die "web bundle payload is unsafe"
    size="$(stat -c '%s' -- "$path")"; (( size >= 1 && size <= 1048576 )) || die "web bundle payload size is invalid"
    chmod 0600 -- "$path"
  done
  MANIFEST_PATH="$staging/manifest.json"; CURRENT_WEB_COMPOSE_PATH="$staging/compose.development.web.yml"
}

manifest_tool() {
  "$NODE_BIN" "$MANIFEST_TOOL" validate --file "$MANIFEST_PATH" --bundle-root "$ARTIFACT_STAGING_DIR" \
    --application "$APPLICATION" --expected-repository "$CD_EXPECTED_REPOSITORY" --expected-ref "$CD_EXPECTED_REF" \
    --web-repository "$CD_WEB_REPOSITORY" --api-manifest-repository "$CD_API_MANIFEST_REPOSITORY" \
    --api-image-repository "$CD_API_IMAGE_REPOSITORY" "$@"
}
manifest_get() { manifest_tool --get "$1"; }

validate_bundle_labels() {
  local ref="$CD_MANIFEST_REPOSITORY@$CURRENT_MANIFEST_DIGEST" expected_source="https://github.com/$CD_EXPECTED_REPOSITORY"
  [[ "$(image_label "$ref" org.opencontainers.image.revision)" == "$CURRENT_SOURCE_COMMIT" ]] || die "web bundle revision label mismatch"
  [[ "$(image_label "$ref" org.opencontainers.image.source)" == "$expected_source" ]] || die "web bundle source label mismatch"
  [[ "$(image_label "$ref" io.elevant.application)" == "$APPLICATION" ]] || die "web bundle application label mismatch"
  [[ "$(image_label "$ref" io.elevant.environment)" == Development ]] || die "web bundle environment label mismatch"
  [[ "$(image_label "$ref" io.elevant.source.run-id)" == "$CURRENT_SOURCE_RUN_ID" ]] || die "web bundle run label mismatch"
  [[ "$(image_label "$ref" io.elevant.api.required-manifest)" == "$CURRENT_API_MANIFEST" ]] || die "web bundle API label mismatch"
  [[ "$(image_label "$ref" io.elevant.openapi.sha256)" == "$CURRENT_OPENAPI_SHA256" ]] || die "web bundle OpenAPI label mismatch"
  [[ "$(image_label "$ref" io.elevant.web-release.schema-version)" == 1 ]] || die "web bundle schema label mismatch"
  [[ "$(image_label "$ref" io.elevant.web-release.bundle-version)" == 1 ]] || die "web bundle version label mismatch"
  [[ "$(image_label "$ref" io.elevant.web-release.media-type)" == application/vnd.elevant.web-release-bundle.v1 ]] || die "web bundle media-type label mismatch"
}

validate_web_image() {
  local image="$1" commit="$2" source_run="$3" api_manifest="$4" openapi="$5" expected_source="https://github.com/$CD_EXPECTED_REPOSITORY"
  [[ "$image" == "$CD_WEB_REPOSITORY@"* && "${image#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "web image is not the configured immutable repository"
  [[ "$(image_label "$image" org.opencontainers.image.revision)" == "$commit" ]] || die "web image revision label mismatch"
  [[ "$(image_label "$image" org.opencontainers.image.source)" == "$expected_source" ]] || die "web image source label mismatch"
  [[ "$(image_label "$image" io.elevant.application)" == "$APPLICATION" ]] || die "web image application label mismatch"
  [[ "$(image_label "$image" io.elevant.environment)" == Development ]] || die "web image environment label mismatch"
  [[ "$(image_label "$image" io.elevant.source.run-id)" == "$source_run" ]] || die "web image source run label mismatch"
  [[ "$(image_label "$image" io.elevant.api.required-manifest)" == "$api_manifest" ]] || die "web image API manifest label mismatch"
  [[ "$(image_label "$image" io.elevant.openapi.sha256)" == "$openapi" ]] || die "web image OpenAPI label mismatch"
  [[ "$(image_label "$image" io.elevant.web.api-origin)" == "$CD_EXPECTED_API_ORIGIN" ]] || die "web image API origin label mismatch"
}

pull_web_image() {
  docker_command pull "$1" >/dev/null || die "could not pull the immutable web image"
}

cached_compose_path() { printf '%s/compose/web/%s.yml\n' "$CD_STATE_DIR" "$1"; }
validate_cached_compose() {
  local file="$1" hash="$2" expected_uid=0 metadata
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  [[ -f "$file" && ! -L "$file" ]] || die "cached web Compose is unavailable"
  metadata="$(stat -c '%u:%a' -- "$file")"; [[ "$metadata" == "$expected_uid:600" ]] || die "cached web Compose ownership or mode is invalid"
  [[ "$(sha256sum -- "$file" | awk '{print $1}')" == "$hash" ]] || die "cached web Compose hash mismatch"
}
cache_compose() {
  local source="$1" hash="$2" target temporary
  [[ "$(sha256sum -- "$source" | awk '{print $1}')" == "$hash" ]] || die "web Compose payload hash mismatch"
  target="$(cached_compose_path "$hash")"
  if [[ -e "$target" ]]; then validate_cached_compose "$target" "$hash"; CURRENT_WEB_COMPOSE_PATH="$target"; return; fi
  temporary="$(mktemp "$CD_STATE_DIR/compose/web/.compose.XXXXXX")"
  install -m 0600 -- "$source" "$temporary"; mv -T -- "$temporary" "$target"
  validate_cached_compose "$target" "$hash"; CURRENT_WEB_COMPOSE_PATH="$target"
}

load_manifest() {
  CURRENT_MANIFEST_DIGEST="$1"; extract_web_bundle "$1"
  manifest_tool >/dev/null || die "certified web manifest validation failed"
  CURRENT_SOURCE_COMMIT="$(manifest_get source.commit)"; CURRENT_SOURCE_RUN_ID="$(manifest_get source.runId)"
  CURRENT_SOURCE_RUN_ATTEMPT="$(manifest_get source.runAttempt)"; CURRENT_WORKFLOW_URL="$(manifest_get source.workflowUrl)"
  CURRENT_WEB_IMAGE="$(manifest_get images.web)"; CURRENT_WEB_COMPOSE_SHA256="$(manifest_get compose.webSha256)"
  CURRENT_API_MANIFEST="$(manifest_get api.requiredManifest)"; CURRENT_API_RUN_ID="$(manifest_get api.requiredRunId)"
  CURRENT_API_IMAGE="$(manifest_get api.requiredImage)"; CURRENT_OPENAPI_SHA256="$(manifest_get api.openApiSha256)"
  CURRENT_CONFIGURATION_SHA256="$(manifest_get build.configurationSha256)"; CURRENT_CONTAINER_PORT="$(manifest_get endpoints.containerPort)"
  CURRENT_HEALTH_PATH="$(manifest_get endpoints.healthPath)"; CURRENT_SMOKE_PATHS="$(manifest_get endpoints.smokePaths)"
  [[ "$CURRENT_CONTAINER_PORT" == "$PROFILE_CONTAINER_PORT" && "$CURRENT_HEALTH_PATH" == "$PROFILE_HEALTH_PATH" && "$CURRENT_SMOKE_PATHS" == "$PROFILE_SMOKE_PATHS" ]] || die "web endpoint contract does not match the selected application profile"
  validate_bundle_labels
  pull_web_image "$CURRENT_WEB_IMAGE"
  validate_web_image "$CURRENT_WEB_IMAGE" "$CURRENT_SOURCE_COMMIT" "$CURRENT_SOURCE_RUN_ID" "$CURRENT_API_MANIFEST" "$CURRENT_OPENAPI_SHA256"
  cache_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_COMPOSE_SHA256"
}

api_container_id() {
  local output
  output="$(docker_command container ls --all --quiet --no-trunc --filter status=running \
    --filter "label=com.docker.compose.project=$CD_API_PROJECT" \
    --filter "label=com.docker.compose.service=$CD_API_SERVICE")" || return 1
  [[ "$output" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$output"
}

validate_api_container() {
  local id="$1" expected_image="$2" inspect status health restarts image
  inspect="$(docker_command container inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}|{{.RestartCount}}|{{.Config.Image}}' "$id")" || return 1
  IFS='|' read -r status health restarts image <<< "$inspect"
  [[ "$status" == running && "$health" == healthy && "$restarts" == 0 && "$image" == "$expected_image" ]]
}

retrieve_api_openapi() {
  local api_id="$1" output="$2" probe_mode="${3:-pull}" url
  url="http://127.0.0.1:$CD_API_CONTAINER_PORT$CD_API_OPENAPI_PATH"
  [[ "$probe_mode" == pull || "$probe_mode" == local ]] || return 1
  if [[ "$probe_mode" == pull ]]; then docker_command pull "$CD_HTTP_PROBE_IMAGE" >/dev/null || return 1; fi
  # The short-lived probe shares only the already-validated API container's
  # network namespace. Dokploy itself joins no API network and no host port is
  # required. All other privileges and writes are denied.
  docker_command run --rm --pull never \
    --network "container:$api_id" \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --pids-limit 32 \
    --memory 64m \
    --cpus 0.10 \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=8m \
    --log-driver none \
    "$CD_HTTP_PROBE_IMAGE" \
    --fail --silent --show-error --connect-timeout 5 --max-time 30 \
    --max-filesize 4194304 --proto '=http' --header 'Accept: application/json' \
    --output - "$url" > "$output"
}

api_gate() {
  local probe_mode="${1:-pull}"
  local metadata expected_uid=0 values active_digest active_run active_image required_digest
  local openapi_file active_openapi api_id
  [[ "$TEST_MODE" != 1 ]] || expected_uid="$(id -u)"
  metadata="$(stat -c '%u:%a' -- "$CD_API_STATE")"; [[ "$metadata" == "$expected_uid:600" ]] || die "API state ownership or mode is invalid"
  values="$("$NODE_BIN" "$STATE_TOOL" validate-api-state --file "$CD_API_STATE")" || die "accepted API state is invalid"
  IFS=$'\t' read -r active_digest active_run active_image <<< "$values"
  [[ "$active_image" == "$CD_API_IMAGE_REPOSITORY@"* && "${active_image#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "accepted API state uses an unexpected image repository"
  required_digest="${CURRENT_API_MANIFEST#*@}"
  if [[ "$active_digest" != "$required_digest" || "$active_run" != "$CURRENT_API_RUN_ID" || "$active_image" != "$CURRENT_API_IMAGE" ]]; then
    log "exact required API release is not active; deployment deferred"; return 2
  fi
  api_id="$(api_container_id)" || die "expected exactly one running API Compose container"
  validate_api_container "$api_id" "$active_image" || die "API container identity, image or health does not match accepted API state"
  openapi_file="$(mktemp "$CD_STATE_DIR/tmp/openapi.XXXXXX.json")"; chmod 0600 -- "$openapi_file"
  if ! retrieve_api_openapi "$api_id" "$openapi_file" "$probe_mode"; then rm -f -- "$openapi_file"; die "could not retrieve OpenAPI from the API container namespace"; fi
  validate_api_container "$api_id" "$active_image" || { rm -f -- "$openapi_file"; die "API container changed while OpenAPI was being verified"; }
  active_openapi="$("$NODE_BIN" "$OPENAPI_TOOL" hash --file "$openapi_file")" || { rm -f -- "$openapi_file"; die "live API OpenAPI is invalid"; }
  rm -f -- "$openapi_file"
  [[ "$active_openapi" == "$CURRENT_OPENAPI_SHA256" ]] || die "live API OpenAPI differs from the certified web requirement"
}

render_compose_hash() {
  local file="$1" output digest
  output="$(mktemp "$CD_STATE_DIR/tmp/compose-model.XXXXXX.json")"; chmod 0600 -- "$output"
  if ! docker_command compose --env-file /dev/null --project-directory "$(dirname -- "$CD_COMPOSE")" -p "$CD_PROJECT" -f "$file" --profile '*' config --format json --no-interpolate --no-env-resolution --no-path-resolution > "$output"; then rm -f -- "$output"; return 1; fi
  digest="$("$NODE_BIN" "$COMPOSE_MODEL_TOOL" hash --file "$output")" || { rm -f -- "$output"; return 1; }
  rm -f -- "$output"; printf '%s\n' "$digest"
}
validate_live_compose_semantics() {
  local certified live
  certified="$(render_compose_hash "$CURRENT_WEB_COMPOSE_PATH")" || die "could not render certified web Compose"
  live="$(render_compose_hash "$CD_COMPOSE")" || die "could not render live web Compose"
  [[ "$certified" == "$live" ]] || die "live web Compose semantics differ from the certified payload"
}
web_compose() {
  local file="$1" image="$2"; shift 2
  env "$CD_IMAGE_ENV=$image" DOCKER_CONFIG="$CD_DOCKER_CONFIG" "$DOCKER_BIN" compose --env-file "$CD_ENV" --project-directory "$(dirname -- "$CD_COMPOSE")" -p "$CD_PROJECT" -f "$file" "$@"
}

read_env_image() {
  local line value="" count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"; [[ "$line" == "$CD_IMAGE_ENV="* ]] || continue
    (( count += 1 )); value="${line#*=}"
  done < "$CD_ENV"
  [[ "$count" == 1 ]] || die "web environment must define $CD_IMAGE_ENV exactly once"
  if [[ "$value" == \"*\" ]]; then value="${value:1:${#value}-2}"; fi
  [[ "$value" == "$CD_WEB_REPOSITORY@"* && "${value#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "live web image is not an expected immutable reference"
  printf '%s\n' "$value"
}
set_env_image() { "$NODE_BIN" "$ENV_TOOL" set --file "$CD_ENV" --key "$CD_IMAGE_ENV" --value "$1"; }

container_id() {
  local output
  output="$(docker_command container ls --all --quiet --no-trunc --filter "label=com.docker.compose.project=$CD_PROJECT" --filter "label=com.docker.compose.service=$CD_SERVICE")" || return 1
  [[ "$output" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$output"
}
wait_healthy() {
  local expected_image="$1" attempt id inspect status health restarts image
  for (( attempt=1; attempt<=WAIT_ATTEMPTS; attempt+=1 )); do
    id="$(container_id 2>/dev/null || true)"
    if [[ -n "$id" ]]; then
      inspect="$(docker_command container inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}missing{{end}}|{{.RestartCount}}|{{.Config.Image}}' "$id" 2>/dev/null || true)"
      IFS='|' read -r status health restarts image <<< "$inspect"
      [[ "$image" == "$expected_image" ]] || return 1
      [[ "$status" == running && "$health" == healthy && "$restarts" == 0 ]] && return 0
      [[ "$status" == exited || "$status" == dead || "$health" == unhealthy ]] && return 1
    fi
    (( WAIT_INTERVAL == 0 )) || sleep "$WAIT_INTERVAL"
  done
  return 1
}
smoke_web() {
  local id path url
  id="$(container_id)" || return 1
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue; url="http://127.0.0.1:$CURRENT_CONTAINER_PORT$path"
    if [[ "$APPLICATION" == aviam-web ]]; then
      docker_command container exec "$id" wget -q -T 10 -O /dev/null "$url" || return 1
    else
      docker_command container exec "$id" node -e 'fetch(process.argv[1]).then((r)=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))' "$url" || return 1
    fi
  done < <("$NODE_BIN" -e 'for (const value of JSON.parse(process.argv[1])) console.log(value)' "$CURRENT_SMOKE_PATHS")
}
preflight() {
  validate_cached_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_COMPOSE_SHA256" || return 1
  validate_web_image "$CURRENT_WEB_IMAGE" "$CURRENT_SOURCE_COMMIT" "$CURRENT_SOURCE_RUN_ID" "$CURRENT_API_MANIFEST" "$CURRENT_OPENAPI_SHA256" || return 1
  validate_live_compose_semantics || return 1
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" config --quiet || return 1
  api_gate
}

state_get() { "$NODE_BIN" "$STATE_TOOL" get --file "$1" --field "$2"; }
attempt_file() { printf '%s/attempts/%s.json\n' "$CD_STATE_DIR" "${1#sha256:}"; }
write_state_file() {
  "$NODE_BIN" "$STATE_TOOL" write --file "$1" \
    --set "application=$APPLICATION" --set "status=$2" --set "stage=$3" --set "manifestDigest=$CURRENT_MANIFEST_DIGEST" \
    --set "sourceCommit=$CURRENT_SOURCE_COMMIT" --set "sourceRunId=$CURRENT_SOURCE_RUN_ID" --set "sourceRunAttempt=$CURRENT_SOURCE_RUN_ATTEMPT" \
    --set "webImage=$CURRENT_WEB_IMAGE" --set "webComposeSha256=$CURRENT_WEB_COMPOSE_SHA256" --set "apiManifest=$CURRENT_API_MANIFEST" \
    --set "apiRunId=$CURRENT_API_RUN_ID" --set "apiImage=$CURRENT_API_IMAGE" --set "openApiSha256=$CURRENT_OPENAPI_SHA256" \
    --set "configurationSha256=$CURRENT_CONFIGURATION_SHA256" --set "rollbackStatus=$CURRENT_ROLLBACK_STATUS" \
    --set "messageCode=$4" --set "updatedAt=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --set "workflowUrl=$CURRENT_WORKFLOW_URL"
}
persist_attempt() {
  write_state_file "$CD_STATE_DIR/current.json" "$1" "$2" "$3" || return 1
  write_state_file "$(attempt_file "$CURRENT_MANIFEST_DIGEST")" "$1" "$2" "$3" || return 1
}
begin_stage() { CURRENT_STAGE="$1"; persist_attempt running "$1" stage_running; log "stage=$1 started"; }
complete_stage() { log "stage=$CURRENT_STAGE completed"; }
is_paused() { [[ -e "$CD_STATE_DIR/paused" ]]; }

matching_state_field_equals() {
  local current="$1" attempt="$2" field="$3" current_value attempt_value
  current_value="$(state_get "$current" "$field")" || pause_and_die "could not read current web attempt $field"
  attempt_value="$(state_get "$attempt" "$field")" || pause_and_die "could not read matching web attempt $field"
  [[ "$current_value" == "$attempt_value" ]] ||
    pause_and_die "current and matching web attempt $field values conflict"
}

validate_matching_attempt_invariants() {
  local current="$1" attempt="$2" field
  for field in application manifestDigest sourceCommit sourceRunId sourceRunAttempt \
    webImage webComposeSha256 apiManifest apiRunId apiImage openApiSha256 \
    configurationSha256 workflowUrl; do
    matching_state_field_equals "$current" "$attempt" "$field"
  done
}

select_running_attempt_state() {
  local current="$CD_STATE_DIR/current.json" current_digest="" current_attempt="" requested_attempt application attempt_digest status
  RUNNING_ATTEMPT_STATE=""
  if [[ -e "$current" || -L "$current" ]]; then
    if ! (validate_restricted_file "$current"); then pause_and_die "current web attempt state is unsafe"; fi
    status="$(state_get "$current" status)" || pause_and_die "could not read current web attempt status"
    application="$(state_get "$current" application)" || pause_and_die "could not read current web attempt application"
    [[ "$application" == "$APPLICATION" ]] || pause_and_die "current web attempt application is invalid"
    [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
      pause_and_die "current web attempt status is invalid"
    if [[ "$status" == running ]]; then RUNNING_ATTEMPT_STATE="$current"; return 0; fi
    current_digest="$(state_get "$current" manifestDigest)" || pause_and_die "could not read current web attempt digest"
    [[ -z "$current_digest" || "$current_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || pause_and_die "current web attempt digest is invalid"
    if [[ -n "$current_digest" ]]; then
      current_attempt="$(attempt_file "$current_digest")"
      if [[ -e "$current_attempt" || -L "$current_attempt" ]]; then
        if ! (validate_restricted_file "$current_attempt"); then pause_and_die "current digest attempt state is unsafe"; fi
        status="$(state_get "$current_attempt" status)" || pause_and_die "could not read current digest attempt status"
        application="$(state_get "$current_attempt" application)" || pause_and_die "could not read current digest attempt application"
        attempt_digest="$(state_get "$current_attempt" manifestDigest)" || pause_and_die "could not read current digest attempt manifest digest"
        [[ "$application" == "$APPLICATION" ]] || pause_and_die "current digest attempt application is invalid"
        [[ "$attempt_digest" == "$current_digest" ]] || pause_and_die "current digest attempt manifest digest does not match its state path"
        [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
          pause_and_die "current digest attempt status is invalid"
        validate_matching_attempt_invariants "$current" "$current_attempt"
        if [[ "$status" == running ]]; then RUNNING_ATTEMPT_STATE="$current_attempt"; return 0; fi
      fi
    fi
  fi
  requested_attempt="$(attempt_file "$REQUESTED_DIGEST")"
  [[ "$requested_attempt" != "$current_attempt" ]] || return 1
  if [[ -e "$requested_attempt" || -L "$requested_attempt" ]]; then
    if ! (validate_restricted_file "$requested_attempt"); then pause_and_die "requested web attempt state is unsafe"; fi
    status="$(state_get "$requested_attempt" status)" || pause_and_die "could not read requested web attempt status"
    application="$(state_get "$requested_attempt" application)" || pause_and_die "could not read requested web attempt application"
    attempt_digest="$(state_get "$requested_attempt" manifestDigest)" || pause_and_die "could not read requested web attempt manifest digest"
    [[ "$application" == "$APPLICATION" ]] || pause_and_die "requested web attempt application is invalid"
    [[ "$attempt_digest" == "$REQUESTED_DIGEST" ]] || pause_and_die "requested web attempt manifest digest does not match its state path"
    [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
      pause_and_die "requested web attempt status is invalid"
    if [[ "$status" == running ]]; then RUNNING_ATTEMPT_STATE="$requested_attempt"; return 0; fi
  fi
  return 1
}

load_attempt_context() {
  local file="$1" expected_status="$2" application status
  [[ "$expected_status" == running || "$expected_status" == failed ]] || pause_and_die "internal attempt status expectation is invalid"
  if ! (validate_restricted_file "$file"); then pause_and_die "web attempt state is unsafe"; fi
  application="$(state_get "$file" application)" || pause_and_die "could not read web attempt application"
  status="$(state_get "$file" status)" || pause_and_die "could not read web attempt status"
  [[ "$application" == "$APPLICATION" && "$status" == "$expected_status" ]] || pause_and_die "web attempt scope or status is invalid"
  CURRENT_STAGE="$(state_get "$file" stage)" || pause_and_die "could not read web attempt stage"
  CURRENT_ROLLBACK_STATUS="$(state_get "$file" rollbackStatus)" || pause_and_die "could not read web attempt rollback status"
  CURRENT_MESSAGE_CODE="$(state_get "$file" messageCode)" || pause_and_die "could not read web attempt message code"
  [[ "$CURRENT_ROLLBACK_STATUS" == not-required || "$CURRENT_ROLLBACK_STATUS" == succeeded || "$CURRENT_ROLLBACK_STATUS" == failed ]] ||
    pause_and_die "web attempt rollback status is invalid"
  [[ -n "$CURRENT_STAGE" && -n "$CURRENT_MESSAGE_CODE" ]] || pause_and_die "web attempt stage or message code is invalid"
  CURRENT_MANIFEST_DIGEST="$(state_get "$file" manifestDigest)" || pause_and_die "could not read web attempt manifest digest"
  CURRENT_SOURCE_COMMIT="$(state_get "$file" sourceCommit)" || pause_and_die "could not read web attempt source commit"
  CURRENT_SOURCE_RUN_ID="$(state_get "$file" sourceRunId)" || pause_and_die "could not read web attempt source run ID"
  CURRENT_SOURCE_RUN_ATTEMPT="$(state_get "$file" sourceRunAttempt)" || pause_and_die "could not read web attempt source run attempt"
  CURRENT_WEB_IMAGE="$(state_get "$file" webImage)" || pause_and_die "could not read web attempt image"
  CURRENT_WEB_COMPOSE_SHA256="$(state_get "$file" webComposeSha256)" || pause_and_die "could not read web attempt Compose hash"
  CURRENT_API_MANIFEST="$(state_get "$file" apiManifest)" || pause_and_die "could not read web attempt API manifest"
  CURRENT_API_RUN_ID="$(state_get "$file" apiRunId)" || pause_and_die "could not read web attempt API run ID"
  CURRENT_API_IMAGE="$(state_get "$file" apiImage)" || pause_and_die "could not read web attempt API image"
  CURRENT_OPENAPI_SHA256="$(state_get "$file" openApiSha256)" || pause_and_die "could not read web attempt OpenAPI hash"
  CURRENT_CONFIGURATION_SHA256="$(state_get "$file" configurationSha256)" || pause_and_die "could not read web attempt configuration hash"
  CURRENT_WORKFLOW_URL="$(state_get "$file" workflowUrl)" || pause_and_die "could not read web attempt workflow URL"
  [[ "$CURRENT_MANIFEST_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || pause_and_die "web attempt manifest digest is invalid"
  [[ "$CURRENT_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ && "$CURRENT_SOURCE_RUN_ID" =~ ^[1-9][0-9]*$ && "$CURRENT_SOURCE_RUN_ATTEMPT" =~ ^[1-9][0-9]*$ ]] ||
    pause_and_die "web attempt source provenance is invalid"
  [[ "$CURRENT_WEB_IMAGE" == "$CD_WEB_REPOSITORY@"* && "${CURRENT_WEB_IMAGE#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    pause_and_die "web attempt image is invalid"
  [[ "$CURRENT_WEB_COMPOSE_SHA256" =~ ^[0-9a-f]{64}$ ]] || pause_and_die "web attempt Compose hash is invalid"
  [[ "$CURRENT_API_MANIFEST" == "$CD_API_MANIFEST_REPOSITORY@"* && "${CURRENT_API_MANIFEST#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    pause_and_die "web attempt API manifest is invalid"
  [[ "$CURRENT_API_RUN_ID" =~ ^[1-9][0-9]*$ ]] || pause_and_die "web attempt API run ID is invalid"
  [[ "$CURRENT_API_IMAGE" == "$CD_API_IMAGE_REPOSITORY@"* && "${CURRENT_API_IMAGE#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    pause_and_die "web attempt API image is invalid"
  [[ "$CURRENT_OPENAPI_SHA256" =~ ^sha256:[0-9a-f]{64}$ && "$CURRENT_CONFIGURATION_SHA256" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    pause_and_die "web attempt fingerprints are invalid"
  [[ "$CURRENT_WORKFLOW_URL" == "https://github.com/$CD_EXPECTED_REPOSITORY/actions/runs/$CURRENT_SOURCE_RUN_ID" ]] ||
    pause_and_die "web attempt workflow URL is invalid"
  CURRENT_WEB_COMPOSE_PATH="$(cached_compose_path "$CURRENT_WEB_COMPOSE_SHA256")"
  CURRENT_CONTAINER_PORT="$PROFILE_CONTAINER_PORT"
  CURRENT_HEALTH_PATH="$PROFILE_HEALTH_PATH"
  CURRENT_SMOKE_PATHS="$PROFILE_SMOKE_PATHS"
}

load_running_attempt_context() {
  load_attempt_context "$1" running
  LOADED_RUNNING_ATTEMPT_STATE="$1"
}

running_attempt_kind() {
  case "$1:$2:$3" in
    preflight:stage_running:not-required|deploy:stage_running:not-required|health:stage_running:not-required|smoke:stage_running:not-required)
      printf 'ordinary\n'
      ;;
    drill-deploy:stage_running:not-required|drill-health:stage_running:not-required|drill-smoke:stage_running:not-required|drill-rollback:stage_running:not-required)
      printf 'drill\n'
      ;;
    drill-repromote:stage_running:succeeded|drill-repromote-health:stage_running:succeeded|drill-repromote-smoke:stage_running:succeeded)
      printf 'drill\n'
      ;;
    interrupted:rollback_drill_interrupted_recovery_deferred:not-required)
      printf 'drill\n'
      ;;
    *) return 1 ;;
  esac
}

validate_matching_running_attempt_pair() {
  local current="$CD_STATE_DIR/current.json" attempt status stage rollback_status message_code attempt_kind current_digest current_kind
  if [[ "$LOADED_RUNNING_ATTEMPT_STATE" != "$current" ]]; then
    [[ -e "$current" || -L "$current" ]] || return 0
    if ! (validate_restricted_file "$current"); then pause_and_die "current web attempt state is unsafe"; fi
    current_digest="$(state_get "$current" manifestDigest)" || pause_and_die "could not read current web attempt digest"
    [[ "$current_digest" == "$CURRENT_MANIFEST_DIGEST" ]] || return 0
    validate_matching_attempt_invariants "$current" "$LOADED_RUNNING_ATTEMPT_STATE"
    status="$(state_get "$current" status)" || pause_and_die "could not read current web attempt status"
    stage="$(state_get "$current" stage)" || pause_and_die "could not read current web attempt stage"
    rollback_status="$(state_get "$current" rollbackStatus)" || pause_and_die "could not read current web attempt rollback status"
    message_code="$(state_get "$current" messageCode)" || pause_and_die "could not read current web attempt message code"
    [[ "$status" != running ]] || pause_and_die "multiple running web attempt states were selected inconsistently"
    classify_terminal_pair_state "$status" "$stage" "$rollback_status" "$message_code" ||
      pause_and_die "current terminal web attempt tuple conflicts with its matching running attempt"
    current_kind="$TERMINAL_STATE_KIND"
    [[ "$current_kind" == "$RUNNING_ATTEMPT_KIND" ]] ||
      pause_and_die "current and matching running web attempt kinds conflict"
    return 0
  fi
  attempt="$(attempt_file "$CURRENT_MANIFEST_DIGEST")"
  [[ -e "$attempt" || -L "$attempt" ]] || return 0
  if ! (validate_restricted_file "$attempt"); then pause_and_die "matching running web attempt state is unsafe"; fi
  status="$(state_get "$attempt" status)" || pause_and_die "could not read matching running web attempt status"
  [[ "$status" == running ]] || pause_and_die "current and matching web attempt statuses conflict"
  validate_matching_attempt_invariants "$current" "$attempt"
  stage="$(state_get "$attempt" stage)" || pause_and_die "could not read matching running web attempt stage"
  rollback_status="$(state_get "$attempt" rollbackStatus)" || pause_and_die "could not read matching running web attempt rollback status"
  message_code="$(state_get "$attempt" messageCode)" || pause_and_die "could not read matching running web attempt message code"
  attempt_kind="$(running_attempt_kind "$stage" "$message_code" "$rollback_status")" ||
    pause_and_die "matching running web attempt tuple is invalid"
  [[ "$attempt_kind" == "$RUNNING_ATTEMPT_KIND" ]] || pause_and_die "current and matching running web attempt kinds conflict"
}

classify_loaded_running_attempt() {
  RUNNING_ATTEMPT_KIND="$(running_attempt_kind "$CURRENT_STAGE" "$CURRENT_MESSAGE_CODE" "$CURRENT_ROLLBACK_STATUS")" || {
    RUNNING_ATTEMPT_KIND=""
    return 1
  }
  validate_matching_running_attempt_pair
}

classify_terminal_resume_state() {
  local status="$1" stage="$2" rollback_status="$3" message_code="$4"
  TERMINAL_STATE_KIND=""
  case "$status:$stage:$rollback_status:$message_code" in
    adopted:adopted-current:not-required:baseline_adopted)
      TERMINAL_STATE_KIND=adopted
      ;;
    succeeded:complete:not-required:promotion_succeeded)
      TERMINAL_STATE_KIND=ordinary
      ;;
    succeeded:complete:succeeded:promotion_with_rollback_drill_succeeded)
      TERMINAL_STATE_KIND=drill
      ;;
    failed:preflight:not-required:preflight_failed|failed:preflight:not-required:rollback_baseline_unavailable)
      TERMINAL_STATE_KIND=ordinary
      ;;
    failed:deploy:succeeded:deployment_failed_rolled_back|failed:health:succeeded:deployment_failed_rolled_back|failed:smoke:succeeded:deployment_failed_rolled_back)
      TERMINAL_STATE_KIND=ordinary
      ;;
    failed:interrupted:succeeded:interrupted_attempt_rolled_back)
      TERMINAL_STATE_KIND=ordinary
      ;;
    *) return 1 ;;
  esac
}

classify_terminal_pair_state() {
  local status="$1" stage="$2" rollback_status="$3" message_code="$4"
  if classify_terminal_resume_state "$status" "$stage" "$rollback_status" "$message_code"; then return 0; fi
  TERMINAL_STATE_KIND=""
  [[ "$status" == failed ]] || return 1
  case "$rollback_status:$message_code" in
    succeeded:rollback_drill_candidate_failed_rolled_back|failed:rollback_drill_candidate_and_rollback_failed)
      [[ "$stage" == drill-deploy || "$stage" == drill-health || "$stage" == drill-smoke ]] || return 1
      ;;
    succeeded:rollback_drill_repromotion_failed_rolled_back|failed:rollback_drill_repromotion_and_rollback_failed)
      [[ "$stage" == drill-repromote || "$stage" == drill-repromote-health || "$stage" == drill-repromote-smoke ]] || return 1
      ;;
    failed:rollback_drill_rollback_failed)
      [[ "$stage" == rollback ]] || return 1
      ;;
    succeeded:rollback_drill_interrupted_rolled_back|failed:rollback_drill_interrupted_rollback_failed|not-required:rollback_drill_interrupted_at_safe_baseline|succeeded:rollback_drill_interrupted_at_safe_baseline|succeeded:rollback_drill_unexpected_error_rolled_back|failed:rollback_drill_unexpected_error_rollback_failed|not-required:rollback_drill_unexpected_error_at_safe_baseline|succeeded:rollback_drill_unexpected_error_at_safe_baseline)
      case "$stage" in
        drill-deploy|drill-health|drill-smoke|drill-rollback|drill-repromote|drill-repromote-health|drill-repromote-smoke|interrupted|complete) ;;
        *) return 1 ;;
      esac
      ;;
    failed:rollback_drill_finalization_recovery_failed)
      [[ "$stage" == interrupted ]] || return 1
      ;;
    *) return 1 ;;
  esac
  TERMINAL_STATE_KIND=drill
}

load_last_success() {
  local file="$CD_STATE_DIR/last-success.json" status
  [[ -e "$file" || -L "$file" ]] || return 1
  validate_restricted_file "$file"
  status="$(state_get "$file" status)" || die "could not read last-success web status"
  [[ "$status" == succeeded || "$status" == adopted ]] || die "last-success web state is invalid"
  LAST_WEB_IMAGE="$(state_get "$file" webImage)" || die "could not read last-success web image"
  LAST_WEB_COMPOSE_SHA256="$(state_get "$file" webComposeSha256)" || die "could not read last-success Compose hash"
  LAST_SOURCE_COMMIT="$(state_get "$file" sourceCommit)" || die "could not read last-success source commit"
  LAST_SOURCE_RUN_ID="$(state_get "$file" sourceRunId)" || die "could not read last-success source run ID"
  LAST_API_MANIFEST="$(state_get "$file" apiManifest)" || die "could not read last-success API manifest"
  LAST_API_RUN_ID="$(state_get "$file" apiRunId)" || die "could not read last-success API run ID"
  LAST_API_IMAGE="$(state_get "$file" apiImage)" || die "could not read last-success API image"
  LAST_OPENAPI_SHA256="$(state_get "$file" openApiSha256)" || die "could not read last-success OpenAPI hash"
  LAST_WEB_COMPOSE_PATH="$(cached_compose_path "$LAST_WEB_COMPOSE_SHA256")"
  [[ "$LAST_WEB_IMAGE" == "$CD_WEB_REPOSITORY@"* && "${LAST_WEB_IMAGE#*@}" =~ ^sha256:[0-9a-f]{64}$ ]] || die "last-success web image is invalid"
  validate_cached_compose "$LAST_WEB_COMPOSE_PATH" "$LAST_WEB_COMPOSE_SHA256"
}
prepare_rollback_baseline() {
  load_last_success || die "a certified last-success baseline is required before promotion"
  # The candidate was pulled and certified while loading its bundle. Verify the
  # rollback image and Compose are also already local before the live env can be
  # mutated; every later Compose up is explicitly registry-independent.
  validate_web_image "$LAST_WEB_IMAGE" "$LAST_SOURCE_COMMIT" "$LAST_SOURCE_RUN_ID" "$LAST_API_MANIFEST" "$LAST_OPENAPI_SHA256"
  web_compose "$LAST_WEB_COMPOSE_PATH" "$LAST_WEB_IMAGE" config --quiet || die "last-success rollback Compose is invalid"
}
rollback() {
  log "rollback started"
  if (
    load_last_success || exit 1
    validate_web_image "$LAST_WEB_IMAGE" "$LAST_SOURCE_COMMIT" "$LAST_SOURCE_RUN_ID" "$LAST_API_MANIFEST" "$LAST_OPENAPI_SHA256" || exit 1
    web_compose "$LAST_WEB_COMPOSE_PATH" "$LAST_WEB_IMAGE" config --quiet || exit 1
    set_env_image "$LAST_WEB_IMAGE" || exit 1
    web_compose "$LAST_WEB_COMPOSE_PATH" "$LAST_WEB_IMAGE" up -d --pull never --no-build --no-deps --force-recreate "$CD_SERVICE" || exit 1
    wait_healthy "$LAST_WEB_IMAGE" || exit 1
    CURRENT_CONTAINER_PORT="$PROFILE_CONTAINER_PORT"
    CURRENT_HEALTH_PATH="$PROFILE_HEALTH_PATH"
    CURRENT_SMOKE_PATHS="$PROFILE_SMOKE_PATHS"
    smoke_web || exit 1
  ); then CURRENT_ROLLBACK_STATUS=succeeded; log "rollback completed"; return 0; fi
  CURRENT_ROLLBACK_STATUS=failed; return 1
}

drill_preflight() {
  local probe_mode="${1:-pull}"
  validate_cached_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_COMPOSE_SHA256"
  validate_web_image "$CURRENT_WEB_IMAGE" "$CURRENT_SOURCE_COMMIT" "$CURRENT_SOURCE_RUN_ID" "$CURRENT_API_MANIFEST" "$CURRENT_OPENAPI_SHA256"
  validate_live_compose_semantics
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" config --quiet || return 1
  api_gate "$probe_mode"
}

validate_drill_baseline() {
  local live_image
  prepare_rollback_baseline
  [[ "$LAST_API_MANIFEST" == "$CURRENT_API_MANIFEST" &&
     "$LAST_API_RUN_ID" == "$CURRENT_API_RUN_ID" &&
     "$LAST_API_IMAGE" == "$CURRENT_API_IMAGE" &&
     "$LAST_OPENAPI_SHA256" == "$CURRENT_OPENAPI_SHA256" ]] ||
    die "rollback drill requires the candidate and baseline to use the exact active API tuple"
  live_image="$(read_env_image)"
  [[ "$live_image" == "$LAST_WEB_IMAGE" ]] || die "rollback drill requires last-success to be the active web image"
  wait_healthy "$LAST_WEB_IMAGE" || die "rollback drill baseline is not healthy or does not use the last-success image"
  CURRENT_CONTAINER_PORT="$PROFILE_CONTAINER_PORT"
  CURRENT_HEALTH_PATH="$PROFILE_HEALTH_PATH"
  CURRENT_SMOKE_PATHS="$PROFILE_SMOKE_PATHS"
  smoke_web || die "rollback drill baseline smoke failed"
}

validate_interrupted_drill_recovery() {
  prepare_rollback_baseline
  [[ "$LAST_API_MANIFEST" == "$CURRENT_API_MANIFEST" &&
     "$LAST_API_RUN_ID" == "$CURRENT_API_RUN_ID" &&
     "$LAST_API_IMAGE" == "$CURRENT_API_IMAGE" &&
     "$LAST_OPENAPI_SHA256" == "$CURRENT_OPENAPI_SHA256" ]] ||
    die "interrupted rollback drill candidate and last-success API tuples differ"
  api_gate local
}

end_drill_tracking() {
  DRILL_ACTIVE=0
  DRILL_MUTATED=0
  trap - ERR INT TERM
}

last_success_is_completed_candidate() {
  local expected_rollback_status="$1" expected_message_code="$2"
  local file="$CD_STATE_DIR/last-success.json" application status stage manifest_digest source_commit source_run_id
  local source_run_attempt web_image compose_sha api_manifest api_run_id api_image openapi_sha configuration_sha
  local rollback_status message_code workflow_url
  [[ -e "$file" || -L "$file" ]] || return 1
  validate_restricted_file "$file"
  application="$(state_get "$file" application)" || die "could not read completed drill application"
  status="$(state_get "$file" status)" || die "could not read completed drill status"
  stage="$(state_get "$file" stage)" || die "could not read completed drill stage"
  manifest_digest="$(state_get "$file" manifestDigest)" || die "could not read completed drill manifest digest"
  source_commit="$(state_get "$file" sourceCommit)" || die "could not read completed drill source commit"
  source_run_id="$(state_get "$file" sourceRunId)" || die "could not read completed drill source run ID"
  source_run_attempt="$(state_get "$file" sourceRunAttempt)" || die "could not read completed drill source run attempt"
  web_image="$(state_get "$file" webImage)" || die "could not read completed drill web image"
  compose_sha="$(state_get "$file" webComposeSha256)" || die "could not read completed drill Compose hash"
  api_manifest="$(state_get "$file" apiManifest)" || die "could not read completed drill API manifest"
  api_run_id="$(state_get "$file" apiRunId)" || die "could not read completed drill API run ID"
  api_image="$(state_get "$file" apiImage)" || die "could not read completed drill API image"
  openapi_sha="$(state_get "$file" openApiSha256)" || die "could not read completed drill OpenAPI hash"
  configuration_sha="$(state_get "$file" configurationSha256)" || die "could not read completed drill configuration hash"
  rollback_status="$(state_get "$file" rollbackStatus)" || die "could not read completed drill rollback status"
  message_code="$(state_get "$file" messageCode)" || die "could not read completed drill message code"
  workflow_url="$(state_get "$file" workflowUrl)" || die "could not read completed drill workflow URL"
  [[ "$application" == "$APPLICATION" &&
     "$status" == succeeded &&
     "$stage" == complete &&
     "$manifest_digest" == "$CURRENT_MANIFEST_DIGEST" &&
     "$source_commit" == "$CURRENT_SOURCE_COMMIT" &&
     "$source_run_id" == "$CURRENT_SOURCE_RUN_ID" &&
     "$source_run_attempt" == "$CURRENT_SOURCE_RUN_ATTEMPT" &&
     "$web_image" == "$CURRENT_WEB_IMAGE" &&
     "$compose_sha" == "$CURRENT_WEB_COMPOSE_SHA256" &&
     "$api_manifest" == "$CURRENT_API_MANIFEST" &&
     "$api_run_id" == "$CURRENT_API_RUN_ID" &&
     "$api_image" == "$CURRENT_API_IMAGE" &&
     "$openapi_sha" == "$CURRENT_OPENAPI_SHA256" &&
     "$configuration_sha" == "$CURRENT_CONFIGURATION_SHA256" &&
     "$rollback_status" == "$expected_rollback_status" &&
     "$message_code" == "$expected_message_code" &&
     "$workflow_url" == "$CURRENT_WORKFLOW_URL" ]]
}

last_success_is_completed_drill_candidate() {
  last_success_is_completed_candidate succeeded promotion_with_rollback_drill_succeeded
}

last_success_is_completed_ordinary_candidate() {
  last_success_is_completed_candidate not-required promotion_succeeded
}

select_finalization_recovery_state() {
  local requested_attempt current="$CD_STATE_DIR/current.json"
  local file status digest message_code
  requested_attempt="$(attempt_file "$REQUESTED_DIGEST")"
  FINALIZATION_RECOVERY_STATE=""
  for file in "$requested_attempt" "$current"; do
    [[ -e "$file" || -L "$file" ]] || continue
    validate_restricted_file "$file"
    status="$(state_get "$file" status)" || die "could not read finalization recovery status"
    [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
      die "finalization recovery state status is invalid"
    digest="$(state_get "$file" manifestDigest)" || die "could not read finalization recovery digest"
    [[ -z "$digest" || "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || die "finalization recovery state digest is invalid"
    if [[ "$file" == "$requested_attempt" && "$digest" != "$REQUESTED_DIGEST" ]]; then
      die "requested web attempt digest does not match its state path"
    fi
    message_code="$(state_get "$file" messageCode)" || die "could not read finalization recovery message code"
    if [[ "$status" == failed && "$digest" == "$REQUESTED_DIGEST" &&
          "$message_code" == rollback_drill_finalization_recovery_failed ]]; then
      FINALIZATION_RECOVERY_STATE="$file"
      return 0
    fi
  done
  return 1
}

reconcile_completed_drill() {
  local gate_status
  command_pause_internal
  log "reconciling a rollback drill interrupted during final state persistence"
  if (( DRILL_ACTIVE == 0 )); then
    if (drill_preflight local); then :; else
      gate_status=$?
      log "completed rollback drill state could not be reconciled because preflight no longer passes"
      return "$gate_status"
    fi
  fi
  if rollback; then
    CURRENT_STAGE=complete
    CURRENT_ROLLBACK_STATUS=succeeded
    if ! persist_attempt succeeded complete promotion_with_rollback_drill_succeeded; then
      log "completed rollback drill state reconciliation could not persist current and attempt state"
      return 1
    fi
    log "completed rollback drill state reconciled; controller remains paused"
    return 0
  fi
  CURRENT_ROLLBACK_STATUS=failed
  command_pause_internal
  persist_attempt failed interrupted rollback_drill_finalization_recovery_failed
  log "completed rollback drill candidate could not be revalidated; controller remains paused"
  return 1
}

recover_interrupted_drill() {
  local gate_status
  command_pause_internal
  CURRENT_STAGE=interrupted
  if (validate_interrupted_drill_recovery); then :; else
    gate_status=$?
    CURRENT_ROLLBACK_STATUS=not-required
    command_pause_internal
    persist_attempt running interrupted rollback_drill_interrupted_recovery_deferred
    log "interrupted rollback drill recovery deferred without mutating the web; restore the exact API tuple and invoke the same digest again"
    return "$gate_status"
  fi
  if rollback; then
    persist_attempt failed interrupted rollback_drill_interrupted_rolled_back
    log "interrupted rollback drill restored last-success; another explicit invocation is required"
  else
    CURRENT_ROLLBACK_STATUS=failed
    command_pause_internal
    persist_attempt failed interrupted rollback_drill_interrupted_rollback_failed
    log "interrupted rollback drill could not restore last-success; controller remains paused"
  fi
  return 1
}

contain_failed_drill_leg() {
  local stage="$1" recovered_code="$2" failed_code="$3" description="$4"
  command_pause_internal
  if rollback; then
    persist_attempt failed "$stage" "$recovered_code"
    log "$description failed at stage=$stage; last-success restored and controller remains paused"
  else
    CURRENT_ROLLBACK_STATUS=failed
    command_pause_internal
    persist_attempt failed "$stage" "$failed_code"
    log "$description and containment rollback failed at stage=$stage; controller remains paused"
  fi
  end_drill_tracking
  return 1
}

fail_drill_rollback() {
  command_pause_internal
  CURRENT_ROLLBACK_STATUS=failed
  persist_attempt failed rollback rollback_drill_rollback_failed
  log "rollback drill could not restore last-success; controller remains paused"
  end_drill_tracking
  return 1
}

handle_drill_signal() {
  local signal="$1" exit_code="$2" message_code
  (( DRILL_ACTIVE == 1 && DRILL_SIGNAL_HANDLING == 0 )) || exit "$exit_code"
  DRILL_SIGNAL_HANDLING=1
  trap - ERR INT TERM
  set +e
  command_pause_internal
  if last_success_is_completed_drill_candidate; then
    if reconcile_completed_drill; then
      log "rollback drill interrupted by SIG$signal after final acceptance; completed state was reconciled"
    else
      log "rollback drill interrupted by SIG$signal after final acceptance; state reconciliation remains incomplete"
    fi
    exit "$exit_code"
  fi
  if (( DRILL_MUTATED == 1 )); then
    if rollback; then
      message_code=rollback_drill_interrupted_rolled_back
    else
      CURRENT_ROLLBACK_STATUS=failed
      command_pause_internal
      message_code=rollback_drill_interrupted_rollback_failed
    fi
  else
    message_code=rollback_drill_interrupted_at_safe_baseline
  fi
  persist_attempt failed "${CURRENT_STAGE:-interrupted}" "$message_code"
  log "rollback drill interrupted by SIG$signal; controller remains paused"
  exit "$exit_code"
}

handle_drill_error() {
  local exit_code="$1" message_code
  (( DRILL_ACTIVE == 1 && DRILL_SIGNAL_HANDLING == 0 )) || return "$exit_code"
  DRILL_SIGNAL_HANDLING=1
  trap - ERR INT TERM
  set +e
  command_pause_internal
  if last_success_is_completed_drill_candidate; then
    if reconcile_completed_drill; then
      log "rollback drill hit an unexpected error after final acceptance; completed state was reconciled"
    fi
    exit "$exit_code"
  fi
  if (( DRILL_MUTATED == 1 )); then
    if rollback; then
      message_code=rollback_drill_unexpected_error_rolled_back
    else
      CURRENT_ROLLBACK_STATUS=failed
      command_pause_internal
      message_code=rollback_drill_unexpected_error_rollback_failed
    fi
  else
    message_code=rollback_drill_unexpected_error_at_safe_baseline
  fi
  persist_attempt failed "${CURRENT_STAGE:-interrupted}" "$message_code"
  log "rollback drill stopped on an unexpected error; controller remains paused"
  exit "$exit_code"
}

fail_deployment() {
  local stage="$1"
  if rollback; then
    persist_attempt failed "$stage" deployment_failed_rolled_back
    log "deployment failed at stage=$stage; rollback succeeded; explicit retry is required"
  else
    CURRENT_ROLLBACK_STATUS=failed; command_pause_internal
    persist_attempt failed "$stage" deployment_and_rollback_failed
    log "deployment and rollback failed; controller paused"
  fi
  return 1
}
deploy() {
  log "promotion accepted commit=$CURRENT_SOURCE_COMMIT manifest=$CURRENT_MANIFEST_DIGEST"
  begin_stage preflight
  if ! preflight; then persist_attempt failed preflight preflight_failed; return 1; fi
  if ! (prepare_rollback_baseline); then persist_attempt failed preflight rollback_baseline_unavailable; return 1; fi
  complete_stage; begin_stage deploy
  set_env_image "$CURRENT_WEB_IMAGE" || { fail_deployment deploy; return 1; }
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" up -d --pull never --no-build --no-deps --force-recreate "$CD_SERVICE" || { fail_deployment deploy; return 1; }
  complete_stage; begin_stage health; wait_healthy "$CURRENT_WEB_IMAGE" || { fail_deployment health; return 1; }
  complete_stage; begin_stage smoke; smoke_web || { fail_deployment smoke; return 1; }
  complete_stage; CURRENT_STAGE=complete; CURRENT_ROLLBACK_STATUS=not-required
  write_state_file "$CD_STATE_DIR/last-success.json" succeeded complete promotion_succeeded
  persist_attempt succeeded complete promotion_succeeded
  log "promotion completed commit=$CURRENT_SOURCE_COMMIT manifest=$CURRENT_MANIFEST_DIGEST"
}
candidate_is_newer() {
  [[ -f "$CD_STATE_DIR/last-success.json" ]] || return 0
  local accepted
  accepted="$(state_get "$CD_STATE_DIR/last-success.json" sourceRunId)" || die "could not read accepted web source run ID"
  [[ -z "$accepted" ]] || (( 10#$CURRENT_SOURCE_RUN_ID > 10#$accepted ))
}

recover_pending_attempt_before_poll() {
  local current="$CD_STATE_DIR/current.json" application status stage digest rollback_status message_code
  local attempt attempt_status attempt_digest current_kind
  [[ -e "$current" || -L "$current" ]] || return 0
  if ! (validate_restricted_file "$current"); then pause_and_die "current web state is unsafe for polling"; fi
  application="$(state_get "$current" application)" || pause_and_die "could not read current web application before polling"
  status="$(state_get "$current" status)" || pause_and_die "could not read current web status before polling"
  [[ "$application" == "$APPLICATION" ]] || pause_and_die "current web state application is invalid for polling"
  [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
    pause_and_die "current web state status is invalid for polling"

  if [[ "$status" == running ]]; then
    command_pause_internal
    load_running_attempt_context "$current"
    classify_loaded_running_attempt || pause_and_die "running web attempt tuple is invalid for polling"
    if [[ "$RUNNING_ATTEMPT_KIND" == drill ]]; then
      pause_and_die "poll found a running rollback drill; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
    fi
    recover_or_reconcile_loaded_ordinary_attempt
    return 1
  fi

  stage="$(state_get "$current" stage)" || pause_and_die "could not read current web stage before polling"
  digest="$(state_get "$current" manifestDigest)" || pause_and_die "could not read current web digest before polling"
  rollback_status="$(state_get "$current" rollbackStatus)" || pause_and_die "could not read current web rollback status before polling"
  message_code="$(state_get "$current" messageCode)" || pause_and_die "could not read current web message code before polling"
  [[ "$rollback_status" == not-required || "$rollback_status" == succeeded || "$rollback_status" == failed ]] ||
    pause_and_die "current web rollback status is invalid for polling"
  [[ -n "$stage" && -n "$message_code" ]] || pause_and_die "current web stage or message code is invalid for polling"
  if [[ "$status" == adopted ]]; then
    [[ -z "$digest" ]] || pause_and_die "adopted current web state has an unexpected manifest digest"
  else
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || pause_and_die "current web state digest is invalid for polling"
  fi
  [[ "$rollback_status" != failed ]] || pause_and_die "current web rollback status is failed; polling remains paused"
  [[ "$message_code" != rollback_drill_* ]] || pause_and_die "failed rollback drill state must be resolved before polling"
  classify_terminal_resume_state "$status" "$stage" "$rollback_status" "$message_code" ||
    pause_and_die "current terminal web state tuple is invalid for polling"
  current_kind="$TERMINAL_STATE_KIND"
  [[ -n "$digest" ]] || return 0

  attempt="$(attempt_file "$digest")"
  [[ -e "$attempt" || -L "$attempt" ]] || return 0
  if ! (validate_restricted_file "$attempt"); then pause_and_die "matching web attempt is unsafe for polling"; fi
  attempt_status="$(state_get "$attempt" status)" || pause_and_die "could not read matching web attempt status before polling"
  attempt_digest="$(state_get "$attempt" manifestDigest)" || pause_and_die "could not read matching web attempt digest before polling"
  [[ "$attempt_status" == running || "$attempt_status" == succeeded || "$attempt_status" == failed ]] ||
    pause_and_die "matching web attempt status is invalid for polling"
  [[ "$attempt_digest" == "$digest" ]] || pause_and_die "matching web attempt digest conflicts with current state"
  validate_matching_attempt_invariants "$current" "$attempt"
  [[ "$attempt_status" == running ]] || return 0

  command_pause_internal
  load_running_attempt_context "$attempt"
  classify_loaded_running_attempt || pause_and_die "matching running web attempt tuple is invalid for polling"
  [[ "$RUNNING_ATTEMPT_KIND" == "$current_kind" ]] || pause_and_die "current and matching running web attempt kinds conflict during polling"
  if [[ "$RUNNING_ATTEMPT_KIND" == drill ]]; then
    pause_and_die "poll found a running rollback drill; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
  fi
  recover_or_reconcile_loaded_ordinary_attempt
  return 1
}

command_poll() {
  is_paused && { log "controller is paused; poll skipped"; return 0; }
  local digest attempt application attempt_digest status gate_status
  digest="$(resolve_alias_digest)"; load_manifest "$digest"
  if [[ -f "$CD_STATE_DIR/last-success.json" && "$(state_get "$CD_STATE_DIR/last-success.json" manifestDigest)" == "$digest" ]]; then log "manifest=$digest is already accepted; poll is a no-op"; return 0; fi
  candidate_is_newer || { log "manifest=$digest is older than or equal to the accepted workflow run; poll is a no-op"; return 0; }
  attempt="$(attempt_file "$digest")"
  if [[ -e "$attempt" || -L "$attempt" ]]; then
    if ! (validate_restricted_file "$attempt"); then pause_and_die "advertised web attempt state is unsafe"; fi
    application="$(state_get "$attempt" application)" || pause_and_die "could not read advertised web attempt application"
    attempt_digest="$(state_get "$attempt" manifestDigest)" || pause_and_die "could not read advertised web attempt digest"
    status="$(state_get "$attempt" status)" || pause_and_die "could not read advertised web attempt status"
    [[ "$application" == "$APPLICATION" && "$attempt_digest" == "$digest" ]] ||
      pause_and_die "advertised web attempt scope or digest is invalid"
    case "$status" in
      succeeded|adopted) log "manifest=$digest is already accepted; poll is a no-op"; return 0 ;;
      failed) log "manifest=$digest previously failed; automatic retry is disabled"; return 0 ;;
      running)
        command_pause_internal
        load_running_attempt_context "$attempt"
        classify_loaded_running_attempt || pause_and_die "advertised running web attempt tuple is invalid for polling"
        if [[ "$RUNNING_ATTEMPT_KIND" == drill ]]; then
          pause_and_die "poll found a running rollback drill; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
        fi
        recover_or_reconcile_loaded_ordinary_attempt || return $?
        return 1
        ;;
      *) pause_and_die "advertised web attempt state contains an unsupported status" ;;
    esac
  fi
  if api_gate; then :; else gate_status=$?; [[ "$gate_status" == 2 ]] && return 0; return "$gate_status"; fi
  deploy
}
command_dry_run() {
  local digest gate_status
  digest="$(resolve_alias_digest)"; load_manifest "$digest"
  if preflight; then :; else gate_status=$?; return "$gate_status"; fi
  log "dry-run passed commit=$CURRENT_SOURCE_COMMIT manifest=$CURRENT_MANIFEST_DIGEST"
}
command_retry() {
  local advertised attempt
  if select_running_attempt_state; then
    load_running_attempt_context "$RUNNING_ATTEMPT_STATE"
    classify_loaded_running_attempt || pause_and_die "running web attempt tuple is invalid before retry"
    if [[ "$RUNNING_ATTEMPT_KIND" == ordinary ]]; then
      pause_and_die "an ordinary web promotion attempt is running; recover it first with --resume"
    fi
    pause_and_die "a rollback drill is running; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
  fi
  is_paused && die "controller is paused"
  advertised="$(resolve_alias_digest)"; [[ "$advertised" == "$REQUESTED_DIGEST" ]] || die "retry digest is not currently advertised"
  load_manifest "$REQUESTED_DIGEST"; candidate_is_newer || die "retry manifest is not newer than last success"
  attempt="$(attempt_file "$REQUESTED_DIGEST")"; [[ -f "$attempt" && "$(state_get "$attempt" status)" == failed ]] || die "only a recorded failed manifest may be retried"
  api_gate || die "API compatibility gate did not pass"; deploy
}
command_promote_with_rollback_drill() {
  is_paused || die "--promote-with-rollback-drill requires the selected profile to be paused"
  local advertised attempt attempt_status="" baseline_digest gate_status
  if select_running_attempt_state; then
    load_running_attempt_context "$RUNNING_ATTEMPT_STATE"
    if ! classify_loaded_running_attempt; then
      command_pause_internal
      die "running web attempt stage, message code or rollback status is invalid"
    fi
    if [[ "$RUNNING_ATTEMPT_KIND" == ordinary ]]; then
      command_pause_internal
      die "an ordinary web promotion attempt is running; recover it first with --resume"
    fi
    [[ "$CURRENT_MANIFEST_DIGEST" == "$REQUESTED_DIGEST" ]] ||
      die "a different rollback drill digest is running; invoke --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST to recover it"
    if last_success_is_completed_drill_candidate; then
      reconcile_completed_drill
      return
    fi
    recover_interrupted_drill
    return 1
  fi
  if select_finalization_recovery_state; then
    load_attempt_context "$FINALIZATION_RECOVERY_STATE" failed
    [[ "$CURRENT_MANIFEST_DIGEST" == "$REQUESTED_DIGEST" ]] || die "finalization recovery digest does not match the explicit request"
    [[ "$CURRENT_STAGE" == interrupted && "$CURRENT_ROLLBACK_STATUS" == failed &&
       "$CURRENT_MESSAGE_CODE" == rollback_drill_finalization_recovery_failed ]] ||
      die "rollback drill finalization recovery state is invalid"
    last_success_is_completed_drill_candidate ||
      die "finalization recovery state does not match the completed last-success candidate"
    reconcile_completed_drill
    return
  fi

  advertised="$(resolve_alias_digest)"
  [[ "$advertised" == "$REQUESTED_DIGEST" ]] || die "rollback drill digest is not currently advertised"
  load_manifest "$REQUESTED_DIGEST"

  attempt="$(attempt_file "$REQUESTED_DIGEST")"
  if [[ -f "$attempt" ]]; then attempt_status="$(state_get "$attempt" status)" || die "could not read rollback drill attempt status"; fi
  case "$attempt_status" in
    "") ;;
    failed) log "explicit rollback drill retry accepted for manifest=$REQUESTED_DIGEST" ;;
    succeeded|adopted) die "rollback drill manifest was already accepted" ;;
    *) die "rollback drill attempt state contains an unsupported status" ;;
  esac

  load_last_success || die "rollback drill requires a certified last-success baseline"
  [[ "$LAST_SOURCE_RUN_ID" =~ ^[1-9][0-9]*$ ]] || die "rollback drill baseline run ID is invalid"
  baseline_digest="$(state_get "$CD_STATE_DIR/last-success.json" manifestDigest)"
  [[ -z "$baseline_digest" || "$baseline_digest" =~ ^sha256:[0-9a-f]{64}$ ]] ||
    die "rollback drill baseline manifest digest is invalid"
  [[ "$baseline_digest" != "$REQUESTED_DIGEST" ]] ||
    die "rollback drill candidate must differ from last-success"
  (( 10#$CURRENT_SOURCE_RUN_ID > 10#$LAST_SOURCE_RUN_ID )) ||
    die "rollback drill candidate is not strictly newer than last-success"
  validate_drill_baseline
  if (drill_preflight); then :; else
    gate_status=$?
    log "rollback drill preflight failed before live mutation"
    return "$gate_status"
  fi

  DRILL_SIGNAL_HANDLING=0
  DRILL_ACTIVE=1
  DRILL_MUTATED=0
  trap 'handle_drill_error $?' ERR
  trap 'handle_drill_signal INT 130' INT
  trap 'handle_drill_signal TERM 143' TERM

  begin_stage drill-deploy
  DRILL_MUTATED=1
  set_env_image "$CURRENT_WEB_IMAGE" || {
    contain_failed_drill_leg drill-deploy rollback_drill_candidate_failed_rolled_back rollback_drill_candidate_and_rollback_failed "rollback drill candidate deployment"
    return 1
  }
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" up -d --pull never --no-build --no-deps --force-recreate "$CD_SERVICE" || {
    contain_failed_drill_leg drill-deploy rollback_drill_candidate_failed_rolled_back rollback_drill_candidate_and_rollback_failed "rollback drill candidate deployment"
    return 1
  }
  complete_stage
  begin_stage drill-health
  wait_healthy "$CURRENT_WEB_IMAGE" || {
    contain_failed_drill_leg drill-health rollback_drill_candidate_failed_rolled_back rollback_drill_candidate_and_rollback_failed "rollback drill candidate validation"
    return 1
  }
  complete_stage
  begin_stage drill-smoke
  smoke_web || {
    contain_failed_drill_leg drill-smoke rollback_drill_candidate_failed_rolled_back rollback_drill_candidate_and_rollback_failed "rollback drill candidate validation"
    return 1
  }

  complete_stage
  begin_stage drill-rollback
  if ! rollback; then fail_drill_rollback; return 1; fi
  DRILL_MUTATED=0

  complete_stage
  begin_stage drill-repromote
  DRILL_MUTATED=1
  set_env_image "$CURRENT_WEB_IMAGE" || {
    contain_failed_drill_leg drill-repromote rollback_drill_repromotion_failed_rolled_back rollback_drill_repromotion_and_rollback_failed "rollback drill candidate re-promotion"
    return 1
  }
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" up -d --pull never --no-build --no-deps --force-recreate "$CD_SERVICE" || {
    contain_failed_drill_leg drill-repromote rollback_drill_repromotion_failed_rolled_back rollback_drill_repromotion_and_rollback_failed "rollback drill candidate re-promotion"
    return 1
  }
  complete_stage
  begin_stage drill-repromote-health
  wait_healthy "$CURRENT_WEB_IMAGE" || {
    contain_failed_drill_leg drill-repromote-health rollback_drill_repromotion_failed_rolled_back rollback_drill_repromotion_and_rollback_failed "rollback drill candidate re-promotion"
    return 1
  }
  complete_stage
  begin_stage drill-repromote-smoke
  smoke_web || {
    contain_failed_drill_leg drill-repromote-smoke rollback_drill_repromotion_failed_rolled_back rollback_drill_repromotion_and_rollback_failed "rollback drill candidate re-promotion"
    return 1
  }

  complete_stage
  CURRENT_STAGE=complete
  CURRENT_ROLLBACK_STATUS=succeeded
  write_state_file "$CD_STATE_DIR/last-success.json" succeeded complete promotion_with_rollback_drill_succeeded
  persist_attempt succeeded complete promotion_with_rollback_drill_succeeded
  end_drill_tracking
  log "promotion with rollback drill completed commit=$CURRENT_SOURCE_COMMIT manifest=$CURRENT_MANIFEST_DIGEST; controller remains paused"
}
command_adopt_current() {
  is_paused && die "controller is paused"
  [[ ! -e "$CD_STATE_DIR/last-success.json" ]] || die "a $APPLICATION baseline already exists"
  CURRENT_WEB_IMAGE="$(read_env_image)"
  CURRENT_SOURCE_COMMIT="$(image_label "$CURRENT_WEB_IMAGE" org.opencontainers.image.revision)"
  CURRENT_SOURCE_RUN_ID="$(image_label "$CURRENT_WEB_IMAGE" io.elevant.source.run-id)"
  CURRENT_API_MANIFEST="$(image_label "$CURRENT_WEB_IMAGE" io.elevant.api.required-manifest)"
  CURRENT_OPENAPI_SHA256="$(image_label "$CURRENT_WEB_IMAGE" io.elevant.openapi.sha256)"
  [[ "$CURRENT_SOURCE_COMMIT" =~ ^[0-9a-f]{40}$ && "$CURRENT_SOURCE_RUN_ID" =~ ^[1-9][0-9]*$ ]] || die "live web provenance is invalid"
  local api_values active_digest
  api_values="$("$NODE_BIN" "$STATE_TOOL" validate-api-state --file "$CD_API_STATE")" || die "accepted API state is invalid"
  IFS=$'\t' read -r active_digest CURRENT_API_RUN_ID CURRENT_API_IMAGE <<< "$api_values"
  [[ "$CURRENT_API_MANIFEST" == "$CD_API_MANIFEST_REPOSITORY@$active_digest" ]] || die "live web image does not require the active API"
  validate_web_image "$CURRENT_WEB_IMAGE" "$CURRENT_SOURCE_COMMIT" "$CURRENT_SOURCE_RUN_ID" "$CURRENT_API_MANIFEST" "$CURRENT_OPENAPI_SHA256"
  CURRENT_WEB_COMPOSE_SHA256="$(sha256sum -- "$CD_COMPOSE" | awk '{print $1}')"; CURRENT_WEB_COMPOSE_PATH="$CD_COMPOSE"; cache_compose "$CD_COMPOSE" "$CURRENT_WEB_COMPOSE_SHA256"
  CURRENT_CONTAINER_PORT="$PROFILE_CONTAINER_PORT"
  CURRENT_HEALTH_PATH="$PROFILE_HEALTH_PATH"
  CURRENT_SMOKE_PATHS="$PROFILE_SMOKE_PATHS"
  web_compose "$CURRENT_WEB_COMPOSE_PATH" "$CURRENT_WEB_IMAGE" config --quiet
  api_gate
  if ! wait_healthy "$CURRENT_WEB_IMAGE"; then
    die "live $APPLICATION baseline is not healthy or does not use its configured image"
  fi
  if ! smoke_web; then die "live $APPLICATION baseline smoke failed"; fi
  CURRENT_STAGE=adopted-current; CURRENT_ROLLBACK_STATUS=not-required
  write_state_file "$CD_STATE_DIR/last-success.json" adopted adopted-current baseline_adopted
  write_state_file "$CD_STATE_DIR/current.json" adopted adopted-current baseline_adopted
  log "live $APPLICATION baseline adopted commit=$CURRENT_SOURCE_COMMIT"
}
command_pause_internal() {
  local temporary; temporary="$(mktemp "$CD_STATE_DIR/.paused.XXXXXX")"
  chmod 0600 -- "$temporary"; printf 'paused\n' > "$temporary"; mv -fT -- "$temporary" "$CD_STATE_DIR/paused"
}
command_pause() { command_pause_internal; log "controller paused"; }

pause_and_die() {
  command_pause_internal
  die "$*"
}

validate_resume_recovery_runtime() {
  [[ -f "$CD_COMPOSE" && ! -L "$CD_COMPOSE" ]] || die "live web Compose is unavailable"
  validate_restricted_file "$CD_ENV"
  validate_restricted_file "$CD_API_STATE"
  [[ -d "$CD_DOCKER_CONFIG" && ! -L "$CD_DOCKER_CONFIG" ]] || die "Docker configuration directory is unavailable"
  docker_command version >/dev/null || die "Docker daemon is unavailable"
  docker_command compose version >/dev/null || die "Docker Compose plugin is unavailable"
}

recover_interrupted_ordinary_attempt() {
  command_pause_internal
  validate_resume_recovery_runtime
  CURRENT_STAGE=interrupted
  if rollback; then
    if ! persist_attempt failed interrupted interrupted_attempt_rolled_back; then
      log "interrupted ordinary promotion rollback succeeded but its state could not be persisted; controller remains paused"
      return 1
    fi
    log "interrupted ordinary promotion restored last-success; invoke --resume again after reviewing the failed attempt"
  else
    CURRENT_ROLLBACK_STATUS=failed
    command_pause_internal
    if ! persist_attempt failed interrupted interrupted_attempt_rollback_failed; then
      log "interrupted ordinary promotion rollback and failure-state persistence both failed; controller remains paused"
      return 1
    fi
    log "interrupted ordinary promotion could not restore last-success; controller remains paused"
  fi
  return 1
}

reconcile_completed_ordinary_promotion() {
  local gate_status
  command_pause_internal
  validate_resume_recovery_runtime
  if (drill_preflight local); then :; else
    gate_status=$?
    log "completed ordinary promotion state could not be reconciled because local preflight no longer passes"
    return "$gate_status"
  fi
  if rollback; then
    CURRENT_STAGE=complete
    CURRENT_ROLLBACK_STATUS=not-required
    if ! persist_attempt succeeded complete promotion_succeeded; then
      log "completed ordinary promotion state reconciliation could not persist current and attempt state"
      return 1
    fi
    log "completed ordinary promotion state reconciled; invoke --resume again after reviewing it"
    return 0
  fi
  CURRENT_ROLLBACK_STATUS=failed
  command_pause_internal
  if ! persist_attempt failed interrupted interrupted_attempt_rollback_failed; then
    log "completed ordinary promotion revalidation and failure-state persistence both failed; controller remains paused"
    return 1
  fi
  log "completed ordinary promotion could not be revalidated; controller remains paused"
  return 1
}

recover_or_reconcile_loaded_ordinary_attempt() {
  [[ "$RUNNING_ATTEMPT_KIND" == ordinary ]] || pause_and_die "internal ordinary promotion recovery classification is invalid"
  if last_success_is_completed_ordinary_candidate; then
    if reconcile_completed_ordinary_promotion; then :; fi
    return 1
  fi
  recover_interrupted_ordinary_attempt
  return 1
}

command_resume() {
  local current="$CD_STATE_DIR/current.json" application status stage digest rollback_status message_code
  local attempt attempt_application attempt_status attempt_stage attempt_digest attempt_rollback_status attempt_message_code
  local current_kind attempt_kind
  if [[ ! -e "$current" && ! -L "$current" ]]; then
    rm -f -- "$CD_STATE_DIR/paused"
    log "controller resumed"
    return
  fi

  # Once state exists, create or retain the pause marker before parsing it. Any
  # malformed or ambiguous tuple must fail closed even if --resume was invoked
  # while the marker was accidentally absent.
  command_pause_internal
  validate_restricted_file "$current"
  application="$(state_get "$current" application)" || die "could not read current web attempt application"
  status="$(state_get "$current" status)" || die "could not read current web attempt status"
  stage="$(state_get "$current" stage)" || die "could not read current web attempt stage"
  digest="$(state_get "$current" manifestDigest)" || die "could not read current web attempt digest"
  rollback_status="$(state_get "$current" rollbackStatus)" || die "could not read current web attempt rollback status"
  message_code="$(state_get "$current" messageCode)" || die "could not read current web attempt message code"
  [[ "$application" == "$APPLICATION" ]] || pause_and_die "current web attempt application is invalid"
  [[ "$status" == running || "$status" == succeeded || "$status" == failed || "$status" == adopted ]] ||
    pause_and_die "current web attempt status is invalid"
  [[ "$rollback_status" == not-required || "$rollback_status" == succeeded || "$rollback_status" == failed ]] ||
    pause_and_die "current web attempt rollback status is invalid"
  [[ -n "$stage" && -n "$message_code" ]] || pause_and_die "current web attempt stage or message code is invalid"
  if [[ "$status" == adopted ]]; then
    [[ -z "$digest" ]] || pause_and_die "adopted current web state has an unexpected manifest digest"
  else
    [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || pause_and_die "current web attempt manifest digest is invalid"
  fi

  if [[ "$status" == running ]]; then
    load_running_attempt_context "$current"
    classify_loaded_running_attempt || pause_and_die "running web attempt stage, message code or rollback status is invalid"
    if [[ "$RUNNING_ATTEMPT_KIND" == drill ]]; then
      pause_and_die "controller has a running rollback drill; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
    fi
    recover_or_reconcile_loaded_ordinary_attempt
    return 1
  fi

  [[ "$rollback_status" != failed ]] || pause_and_die "current web rollback status is failed; manual recovery is required before resume"
  [[ "$message_code" != rollback_drill_* ]] ||
    pause_and_die "a failed rollback drill must be resolved with --promote-with-rollback-drill $digest before resume"
  classify_terminal_resume_state "$status" "$stage" "$rollback_status" "$message_code" ||
    pause_and_die "current web state stage, message code or rollback status is invalid for resume"
  current_kind="$TERMINAL_STATE_KIND"

  if [[ -n "$digest" ]]; then
    attempt="$(attempt_file "$digest")"
    if [[ -e "$attempt" || -L "$attempt" ]]; then
      validate_restricted_file "$attempt"
      attempt_application="$(state_get "$attempt" application)" || die "could not read matching web attempt application"
      attempt_status="$(state_get "$attempt" status)" || die "could not read matching web attempt status"
      attempt_stage="$(state_get "$attempt" stage)" || die "could not read matching web attempt stage"
      attempt_digest="$(state_get "$attempt" manifestDigest)" || die "could not read matching web attempt digest"
      attempt_rollback_status="$(state_get "$attempt" rollbackStatus)" || die "could not read matching web attempt rollback status"
      attempt_message_code="$(state_get "$attempt" messageCode)" || die "could not read matching web attempt message code"
      [[ "$attempt_application" == "$APPLICATION" && "$attempt_digest" == "$digest" ]] ||
        pause_and_die "matching web attempt scope or digest is invalid"
      validate_matching_attempt_invariants "$current" "$attempt"
      [[ "$attempt_status" == running || "$attempt_status" == succeeded || "$attempt_status" == failed ]] ||
        pause_and_die "matching web attempt status is invalid"
      [[ "$attempt_rollback_status" == not-required || "$attempt_rollback_status" == succeeded || "$attempt_rollback_status" == failed ]] ||
        pause_and_die "matching web attempt rollback status is invalid"
      [[ -n "$attempt_stage" && -n "$attempt_message_code" ]] ||
        pause_and_die "matching web attempt stage or message code is invalid"

      if [[ "$attempt_status" == running ]]; then
        load_running_attempt_context "$attempt"
        classify_loaded_running_attempt || pause_and_die "running matching web attempt tuple is invalid"
        attempt_kind="$RUNNING_ATTEMPT_KIND"
        [[ "$attempt_kind" == "$current_kind" ]] || pause_and_die "current and matching running web attempt kinds conflict"
        if [[ "$attempt_kind" == drill ]]; then
          pause_and_die "controller has a running rollback drill; recover it with --promote-with-rollback-drill $CURRENT_MANIFEST_DIGEST"
        fi
        recover_or_reconcile_loaded_ordinary_attempt
        return 1
      fi

      [[ "$attempt_rollback_status" != failed ]] || pause_and_die "matching web attempt rollback status is failed; manual recovery is required before resume"
      [[ "$attempt_message_code" != rollback_drill_* ]] ||
        pause_and_die "a matching failed rollback drill must be resolved before resume"
      classify_terminal_resume_state "$attempt_status" "$attempt_stage" "$attempt_rollback_status" "$attempt_message_code" ||
        pause_and_die "matching web attempt tuple is invalid for resume"
      attempt_kind="$TERMINAL_STATE_KIND"
      [[ "$attempt_kind" == "$current_kind" && "$attempt_status" == "$status" && "$attempt_stage" == "$stage" &&
         "$attempt_rollback_status" == "$rollback_status" && "$attempt_message_code" == "$message_code" ]] ||
        pause_and_die "current and matching terminal web attempt states conflict"
    fi
  fi

  rm -f -- "$CD_STATE_DIR/paused"
  log "controller resumed"
}
command_status() {
  if is_paused; then printf 'paused=true\n'; else printf 'paused=false\n'; fi
  printf 'application=%s\n' "$APPLICATION"
  printf 'current:\n'; "$NODE_BIN" "$STATE_TOOL" show --file "$CD_STATE_DIR/current.json"
  printf 'last-success:\n'; "$NODE_BIN" "$STATE_TOOL" show --file "$CD_STATE_DIR/last-success.json"
}
cleanup() {
  if [[ -n "$ARTIFACT_STAGING_DIR" ]]; then
    case "$ARTIFACT_STAGING_DIR" in "$CD_STATE_DIR"/tmp/web-bundle.*) rm -rf -- "$ARTIFACT_STAGING_DIR" ;; *) log "WARNING: refused unsafe web bundle cleanup" ;; esac
  fi
}
on_exit() { local result=$?; set +e; cleanup; return "$result"; }

main() {
  trap on_exit EXIT; parse_args "$@"; configure_profile_contract
  [[ "$TEST_MODE" == 1 ]] || (( EUID == 0 )) || die "must run as root inside the private Dokploy container"
  for command in "$DOCKER_BIN" "$NODE_BIN" awk basename chmod date dirname env flock id install mktemp mv rm sha256sum sleep stat touch; do require_command "$command"; done
  load_config; ensure_runtime_directories
  if [[ "$COMMAND" == status ]]; then validate_runtime_files; command_status; return; fi
  acquire_locks
  if [[ "$COMMAND" == poll && -e "$CD_STATE_DIR/paused" ]]; then log "controller is paused; poll skipped"; return; fi
  validate_runtime_files
  if [[ "$COMMAND" == poll ]]; then
    recover_pending_attempt_before_poll
  fi
  case "$COMMAND" in
    poll) command_poll ;; dry-run) command_dry_run ;; retry) command_retry ;;
    promote-with-rollback-drill) command_promote_with_rollback_drill ;;
    adopt-current) command_adopt_current ;;
    pause) command_pause ;; resume) command_resume ;; *) die "internal command dispatch error" ;;
  esac
}

main "$@"
