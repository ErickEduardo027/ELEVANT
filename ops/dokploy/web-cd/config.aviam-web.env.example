# Replace every REPLACE_* value only in the restricted installed copy.
# Keep this repository example secret-free.
ELEVANT_WEB_CD_APPLICATION=aviam-web
ELEVANT_WEB_CD_MANIFEST_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-aviam-web-release-manifest
ELEVANT_WEB_CD_MANIFEST_ALIAS=development-certified
ELEVANT_WEB_CD_EXPECTED_REPOSITORY=REPLACE_OWNER/REPLACE_REPOSITORY
ELEVANT_WEB_CD_EXPECTED_REF=refs/heads/Development
ELEVANT_WEB_CD_WEB_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-private-web

# Exact API dependency. The state is written by the already-installed API CD.
ELEVANT_WEB_CD_API_MANIFEST_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-api-release-manifest
ELEVANT_WEB_CD_API_IMAGE_REPOSITORY=ghcr.io/REPLACE_NAMESPACE/elevant-api
ELEVANT_WEB_CD_API_STATE=/etc/dokploy/elevant/api-cd/state/last-success.json
ELEVANT_WEB_CD_API_LOCK=/etc/dokploy/elevant/api-cd/state/controller.lock
ELEVANT_WEB_CD_API_PROJECT=REPLACE_API_COMPOSE_PROJECT
ELEVANT_WEB_CD_API_SERVICE=api
ELEVANT_WEB_CD_API_CONTAINER_PORT=8080
ELEVANT_WEB_CD_API_OPENAPI_PATH=/swagger/v1/swagger.json
ELEVANT_WEB_CD_HTTP_PROBE_IMAGE=docker.io/curlimages/curl@sha256:REPLACE_DIGEST
ELEVANT_WEB_CD_EXPECTED_API_ORIGIN=https://REPLACE_PRIVATE_API_HOST
ELEVANT_WEB_CD_DATABASE_LOCK=/etc/dokploy/elevant/database-cd/state/controller.lock

# Paths are inside the private Dokploy container. Create the Raw Compose
# resource manually from reviewed inputs, keep AutoDeploy off, and stage its
# exact certified Compose before allowing a promotion.
ELEVANT_WEB_CD_DOCKER_CONFIG=/root/.docker
ELEVANT_WEB_CD_PROJECT=REPLACE_AVIAM_WEB_COMPOSE_PROJECT
ELEVANT_WEB_CD_COMPOSE=/etc/dokploy/compose/REPLACE_AVIAM_WEB_RESOURCE/code/docker-compose.yml
ELEVANT_WEB_CD_ENV=/etc/dokploy/compose/REPLACE_AVIAM_WEB_RESOURCE/code/.env
ELEVANT_WEB_CD_SERVICE=aviam-web
ELEVANT_WEB_CD_IMAGE_ENV=ELEVANT_AVIAM_WEB_IMAGE

ELEVANT_WEB_CD_STATE_DIR=/etc/dokploy/elevant/web-cd/state/aviam-web
ELEVANT_WEB_CD_LOG_DIR=/etc/dokploy/elevant/web-cd/log/aviam-web
ELEVANT_WEB_CD_GLOBAL_LOCK=/etc/dokploy/elevant/web-cd/state/controller.lock
ELEVANT_WEB_CD_LOCK_FILE=/etc/dokploy/elevant/web-cd/state/aviam-web/controller.lock
