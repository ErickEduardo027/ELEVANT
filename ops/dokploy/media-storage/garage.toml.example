# Copy to a private host file. Replace the RPC secret before starting Garage.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "elevant-dev-media:3901"
rpc_secret = "REPLACE_WITH_64_RANDOM_HEX_CHARACTERS"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.invalid"
